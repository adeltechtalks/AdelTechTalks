---
/* The frozen browser-chrome frame — 44px bar, three dots, a real URL.

   Used by the homepage featured build and by the Build Story hero. The frame
   is fixed layout on purpose: the screen inside is a real screenshot swapped in
   later, and `object-fit: cover` on a fixed aspect-ratio box means swapping it
   cannot move a pixel of anything around it.

   Empty, it renders a calm screen rather than a dashed box with a picture
   glyph — that idiom means "this image failed to load", which is the one thing
   an empty-by-design slot must not say. Never a mock-up, never a holding page.
*/

interface Props {
  /** The real domain to show in the bar, with or without a scheme. */
  url: string;
  src?: string;
  alt?: string;
  /** Desktop aspect ratio; mobile always steps to 4/3. */
  ratio?: string;
  priority?: boolean;
  class?: string;
}

const { url, src, alt = '', ratio = '16 / 10', priority = false, class: className } = Astro.props;
const domain = url.replace(/^https?:\/\//, '').replace(/\/$/, '');
---

{/* A URL bar does not mirror, in any language. */}
<div class:list={['bf', className]} dir="ltr" style={`--bf-ratio:${ratio}`}>
  <div class="bf__bar">
    <span class="bf__dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="bf__url">
      <svg class="bf__lock" width="11" height="11" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <rect x="4" y="10" width="16" height="11" rx="2"></rect>
        <path d="M8 10V7a4 4 0 0 1 8 0v3"></path>
      </svg>
      {domain}
    </span>
  </div>
  <div class="bf__screen">
    {src ? (
      <img class="bf__shot" src={src} alt={alt} loading={priority ? 'eager' : 'lazy'} decoding="async" />
    ) : (
      <span class="bf__empty" aria-hidden="true"></span>
    )}
  </div>
</div>

<style>
  .bf {
    background: var(--adel-white);
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
  }
  .bf__bar {
    display: flex;
    align-items: center;
    gap: var(--atc-space-4);
    height: 44px;
    padding-inline: var(--atc-space-4);
    background: #252b3d;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .bf__dots { display: flex; gap: 6px; flex: none; }
  .bf__dots i { width: 10px; height: 10px; border-radius: 50%; background: rgba(255, 255, 255, 0.25); }
  .bf__url {
    flex: 1;
    display: flex;
    align-items: center;
    gap: var(--atc-space-2);
    height: 28px;
    padding-inline: var(--atc-space-4);
    border-radius: var(--adel-radius-pill);
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.1);
    font-family: var(--adel-font-mono);
    font-size: 11.5px;
    color: rgba(255, 255, 255, 0.85);
  }
  .bf__lock { flex: none; color: var(--adel-mint-500); }

  .bf__screen { aspect-ratio: var(--bf-ratio); }
  .bf__shot { display: block; width: 100%; height: 100%; object-fit: cover; }
  .bf__empty {
    display: block;
    height: 100%;
    background: linear-gradient(180deg, #f7f8fa 0%, #eceff4 100%);
  }

  @media (max-width: 767px) {
    .bf__bar { height: 36px; }
    .bf__url { height: 24px; font-size: 10.5px; }
    .bf__screen { aspect-ratio: 4 / 3; }
  }
</style>
