{
  "id": "motion-carousel",
  "name": "Motion Carousel",
  "purpose": "A 5-6 slide social carousel where each slide is a short motion clip instead of a static image.",
  "default_slide_duration_seconds": 5,
  "default_slide_count": [5, 6],
  "default_canvas": {"width": 1080, "height": 1350, "fps": 30},
  "alternate_canvas": {"width": 1080, "height": 1920, "fps": 30},
  "audio": {"default": "muted", "allow_natural_audio": true, "allow_voiceover": true},
  "exports": ["individual_slide_mp4s", "stitched_preview_mp4", "poster_pngs"],
  "content_rules": {
    "one_primary_idea_per_slide": true,
    "headline_words_max": 10,
    "body_lines_max": 3,
    "product_visual_priority": true,
    "rtl_first_for_arabic": true
  },
  "motion_presets": ["hero_push", "macro_drift", "parallax_left", "parallax_right", "feature_reveal", "split_reveal", "clean_hold"],
  "transition_rules": {
    "between_slides": "none_required_each_slide_is_independent",
    "stitched_preview": ["cut", "match_cut"],
    "avoid": ["generic_whoosh", "spin", "random_zoom", "template_heavy_transition"]
  },
  "brand_slots": {
    "signature": "assets/signature.png",
    "logo": "assets/logo.png"
  }
}
