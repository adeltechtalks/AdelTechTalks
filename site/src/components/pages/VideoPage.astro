---
/* Structured video detail (Phase 1.1)
   -----------------------------------------------------------------------------
   The page is the structure. A visitor who never presses play should still
   leave with the chapters, the takeaways and the prompts — which is also what
   makes the video indexable, translatable and linkable at a timestamp.

   No iframe. The poster is a YouTube thumbnail and the play control is a link
   out, so the page costs one image rather than ~1MB of third-party script
   (§31). Chapters deep-link with ?t=, which YouTube honours. */

import Base from '../../layouts/Base.astro';
import Prose from '../editorial/Prose.astro';
import Divider from '../editorial/Divider.astro';
import NewsletterCTA from '../editorial/NewsletterCTA.astro';
import EntryList from '../editorial/EntryList.astro';
import Rich from '../Rich.astro';
import Icon from '../Icon.astro';
import { getRelated, getPromptsBySlug, findTopic, translationsOf } from '../../lib/content';
import { findSeries, seriesPath } from '../../lib/series';
import { useCopy } from '../../copy';
import { formatDate, localizePath, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
  slug: string;
  data: {
    title: string;
    description: string;
    date: Date;
    updated?: Date;
    topic?: string;
    tags: string[];
    related: string[];
    series?: string;
    part?: number;
    youtubeId: string;
    chapters: Array<{ at: number; title: string }>;
    takeaways: string[];
    promptSlugs: string[];
    duration?: string;
    minutes?: number;
  };
}

const { lang, slug, data } = Astro.props;
const c = useCopy(lang);

const topic = findTopic(data.topic);
const series = findSeries(data.series);
const related = await getRelated(lang, data.related);
const prompts = await getPromptsBySlug(lang, data.promptSlugs);

const watchUrl = `https://www.youtube.com/watch?v=${data.youtubeId}`;
const poster = `https://i.ytimg.com/vi/${data.youtubeId}/maxresdefault.jpg`;
const isoDate = data.date.toISOString();
const alternateLinks = await translationsOf('video', slug, lang);

/* mm:ss, or h:mm:ss past an hour. Western digits in both languages (§11). */
function stamp(seconds: number): string {
  const h = Math.floor(seconds / 3600);
  const m = Math.floor((seconds % 3600) / 60);
  const s = seconds % 60;
  const pad = (n: number) => String(n).padStart(2, '0');
  return h > 0 ? `${h}:${pad(m)}:${pad(s)}` : `${m}:${pad(s)}`;
}
---

<Base
  lang={lang}
  title={data.title}
  description={data.description}
  ogType="article"
  ogImage={poster}
  publishedTime={isoDate}
  alternateLinks={alternateLinks}
>
  <article class="container vp">
    <header class="vp__head">
      <nav class="vp__crumbs" aria-label="Breadcrumb">
        <a href={localizePath('/videos', lang)}>{c.videos.title}</a>
        {topic && (
          <>
            <span class="vp__sep" aria-hidden="true">/</span>
            <a href={localizePath(`/topics/${topic.id}`, lang)}>
              <Rich text={topic[lang].name} />
            </a>
          </>
        )}
      </nav>

      {series && (
        <a class="vp__series" href={localizePath(seriesPath(series.id), lang)}>
          <span class="vp__seriesLabel">{c.series.label}</span>
          <Rich text={series[lang].name} />
          {data.part != null && <span class="nums">{c.series.partLabel(data.part)}</span>}
        </a>
      )}

      <h1 class="vp__title ar-hero">{data.title}</h1>
      <p class="vp__desc">{data.description}</p>

      <div class="vp__meta">
        <time class="nums" datetime={isoDate.slice(0, 10)}>
          {c.common.published} {formatDate(data.date, lang, true)}
        </time>
        {data.duration && (
          <>
            <span class="vp__dot" aria-hidden="true">·</span>
            <span class="nums" dir="ltr">{data.duration}</span>
          </>
        )}
      </div>
    </header>

    {/* ---- poster, linking out ---- */}
    <a class="vp__player" href={watchUrl} rel="noopener" target="_blank">
      <img
        class="vp__poster"
        src={poster}
        alt=""
        loading="eager"
        decoding="async"
        width="1280"
        height="720"
      />
      <span class="vp__play" aria-hidden="true"><Icon name="play" size="lg" /></span>
      <span class="vp__playLabel"><Rich text={c.videos.watchOn} /></span>
    </a>

    {data.takeaways.length > 0 && (
      <section class="vp__takeaways" aria-labelledby="vp-take">
        <h2 class="vp__h2" id="vp-take">{c.videos.takeawaysTitle}</h2>
        <ul class="vp__takeList">
          {data.takeaways.map((t) => (
            <li class="vp__take">
              <span class="vp__tick" aria-hidden="true"><Icon name="check" size="sm" /></span>
              <span>{t}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    {data.chapters.length > 0 && (
      <section class="vp__chapters" aria-labelledby="vp-chap">
        <h2 class="vp__h2" id="vp-chap">{c.videos.chaptersTitle}</h2>
        <ol class="vp__chapList">
          {data.chapters.map((ch) => {
            const at = stamp(ch.at);
            return (
              <li class="vp__chap">
                <a
                  class="vp__chapLink"
                  href={`${watchUrl}&t=${ch.at}s`}
                  rel="noopener"
                  target="_blank"
                  aria-label={`${ch.title} — ${c.videos.openAt(at)}`}
                >
                  <span class="vp__at nums" dir="ltr">{at}</span>
                  <span class="vp__chapTitle">{ch.title}</span>
                </a>
              </li>
            );
          })}
        </ol>
      </section>
    )}

    <Prose class="vp__prose">
      <slot />
    </Prose>

    {prompts.length > 0 && (
      <section class="vp__prompts" aria-labelledby="vp-prompts">
        <div class="vp__rule"><Divider /></div>
        <h2 class="vp__h2" id="vp-prompts"><Rich text={c.videos.promptsTitle} /></h2>
        <EntryList entries={prompts} lang={lang} showKind={false} />
      </section>
    )}

    {related.length > 0 && (
      <section class="vp__related" aria-labelledby="vp-related">
        <div class="vp__rule"><Divider label={c.guides.relatedTitle} /></div>
        <h2 class="sr-only" id="vp-related">{c.guides.relatedTitle}</h2>
        <EntryList entries={related} lang={lang} />
      </section>
    )}

    <div class="vp__cta">
      <NewsletterCTA lang={lang} placement="video" variant="plain" />
    </div>
  </article>
</Base>

<style>
  .vp {
    max-width: 820px;
    padding-block-end: var(--atc-space-16);
  }
  .vp__head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--atc-space-4);
    margin-bottom: var(--atc-space-8);
  }
  .vp__crumbs {
    display: flex;
    align-items: center;
    gap: var(--atc-space-2);
    font-size: var(--adel-text-sm);
    color: var(--adel-text-secondary);
  }
  .vp__crumbs a { color: var(--adel-text-secondary); text-decoration: none; }
  .vp__crumbs a:hover { color: var(--adel-text-link); text-decoration: underline; }
  .vp__sep { color: var(--adel-text-tertiary); }

  .vp__series {
    display: inline-flex;
    align-items: center;
    gap: var(--atc-space-2);
    padding: 5px 12px;
    border-radius: var(--adel-radius-pill);
    border: 1px solid var(--adel-border-brand);
    background: var(--adel-surface-tint);
    font-size: var(--adel-text-xs);
    font-weight: 600;
    color: var(--adel-text-on-tint);
    text-decoration: none;
  }
  .vp__seriesLabel {
    letter-spacing: var(--adel-tracking-wide);
    text-transform: uppercase;
    opacity: 0.75;
  }
  :global([lang='ar']) .vp__seriesLabel { text-transform: none; letter-spacing: normal; }

  .vp__title {
    margin: 0;
    font-family: var(--adel-font-display);
    font-size: clamp(28px, 4.2vw, 42px);
    line-height: 1.15;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--adel-text-primary);
    text-wrap: balance;
  }
  .vp__desc {
    margin: 0;
    font-size: var(--adel-text-lg);
    line-height: 1.6;
    color: var(--adel-text-secondary);
  }
  .vp__meta {
    display: flex;
    align-items: center;
    gap: var(--atc-space-2);
    flex-wrap: wrap;
    font-family: var(--adel-font-mono);
    font-size: var(--adel-text-xs);
    color: var(--adel-text-tertiary);
  }
  .vp__dot { opacity: 0.6; }

  /* ---- poster ---- */
  .vp__player {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    margin-bottom: var(--atc-space-10);
    border-radius: var(--adel-radius-media);
    overflow: hidden;
    background: var(--adel-surface-sunken);
    text-decoration: none;
  }
  .vp__poster { width: 100%; height: 100%; object-fit: cover; display: block; }
  .vp__play {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    transform: translate(-50%, -50%);
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--adel-white);
    color: var(--adel-graphite);
    box-shadow: var(--adel-elevation-3);
  }
  /* The play triangle points the way video plays, which is LTR everywhere. It
     is not a directional UI affordance and must not mirror (§29). The centring
     translate has to be undone in RTL, though, or it lands off-canvas. */
  :global([dir='rtl']) .vp__play { transform: translate(50%, -50%); }
  .vp__playLabel {
    position: absolute;
    inset-block-end: var(--atc-space-4);
    inset-inline-start: var(--atc-space-4);
    padding: 6px 14px;
    border-radius: var(--adel-radius-pill);
    background: rgba(23, 26, 31, 0.78);
    color: var(--adel-white);
    font-size: var(--adel-text-xs);
    font-weight: 600;
  }

  .vp__h2 {
    margin: 0 0 var(--atc-space-4);
    font-family: var(--adel-font-display-sm);
    font-size: clamp(20px, 2.4vw, 26px);
    line-height: 1.3;
    font-weight: 700;
    letter-spacing: var(--adel-tracking-tight);
    color: var(--adel-text-primary);
  }
  :global([lang='ar']) .vp__h2 { letter-spacing: normal; line-height: 1.45; }

  /* ---- takeaways ---- */
  .vp__takeaways { margin-bottom: var(--atc-space-10); }
  .vp__takeList { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--atc-space-3); }
  .vp__take {
    display: flex;
    align-items: flex-start;
    gap: var(--atc-space-3);
    font-size: var(--adel-text-base);
    line-height: 1.6;
    color: var(--adel-text-primary);
  }
  .vp__tick {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    flex: 0 0 auto;
    margin-top: 2px;
    border-radius: 50%;
    background: var(--adel-surface-tint);
    color: var(--adel-signature-blue);
  }

  /* ---- chapters ---- */
  .vp__chapters { margin-bottom: var(--atc-space-10); }
  .vp__chapList {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--adel-border-hairline);
  }
  .vp__chap { border-bottom: 1px solid var(--adel-border-hairline); }
  .vp__chapLink {
    display: flex;
    align-items: baseline;
    gap: var(--atc-space-4);
    padding: var(--atc-space-3) 0;
    text-decoration: none;
    color: inherit;
  }
  .vp__chapLink:hover .vp__chapTitle { color: var(--adel-text-link); }
  .vp__at {
    flex: 0 0 auto;
    min-width: 52px;
    font-family: var(--adel-font-mono);
    font-size: var(--adel-text-xs);
    color: var(--adel-signature-blue);
  }
  .vp__chapTitle {
    font-size: var(--adel-text-base);
    line-height: 1.5;
    color: var(--adel-text-primary);
  }

  .vp__prompts,
  .vp__related { margin-top: var(--atc-space-16); }
  .vp__rule { margin-bottom: var(--atc-space-8); }
  .vp__cta { margin-top: var(--atc-space-16); }

  @media (max-width: 599px) {
    .vp__play { width: 52px; height: 52px; }
  }
</style>
