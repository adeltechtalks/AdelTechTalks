---
/* =============================================================================
   Footer — the frozen IA, and where the brand architecture is stated plainly
   =============================================================================
   ── THREE COLUMNS, FROM THE DESIGN OF RECORD ────────────────────────────────
   Website Structure v2 names them and fills them:

     Explore         Vibe Coding · Gear · Learn · Playground
     Learn           Use Cases · Prompt Library · Guides · Videos
     AdelTechTalks   About · Subscribe · Contact

   The first column is the four PILLARS in the frozen nav order, from the same
   `nav` list in site.config.ts the header reads, so the two cannot drift. It is
   never filtered by content: all four are the site's navigation, all four have
   designed empty states, and a footer that quietly dropped "Gear" on the day
   nothing was published would contradict the header two screens above it.

   The second column is different, and deliberately so. Guides, Use cases,
   Videos and the Prompt Library are SURFACES: /guides with nothing in it is an
   empty index rather than an answer, so a surface with nothing published in
   this language is dropped until it leads somewhere. The Prompt Library keeps
   its named-but-unlinked "· soon" treatment while it is genuinely closed — a
   label is not a promise; a link would be.

   The third column is the channel: the two chrome destinations that are not
   pillars, plus the way to reach a human.

   ── BRAND ARCHITECTURE ──────────────────────────────────────────────────────
   Website Structure v2 puts the AdelTechTalks lockup in the footer's brand
   slot, above the umbrella line, and names the third column after the channel.
   Adel remains the site's subject; AdelTechTalks is the identity that carries
   it, and it is the thing a reader recognises at the bottom of a page.

   ── NO SEPARATE-BUSINESS ROW ────────────────────────────────────────────────
   The footer previously carried a row linking out to a separate business. It is
   gone, and with it the last place on any shared template that read from
   `projects[]`: "No homepage or primary template may depend on it." The config
   array and its rendering rules are untouched in site.config.ts — what changed
   is that the chrome no longer requires an entry to exist.
   ========================================================================== */

import Logo from './Logo.astro';
import Rich from './Rich.astro';
import { nav } from '../site.config';
import { emptySurfaces } from '../lib/content';
import { useCopy } from '../copy';
import {
  DEFAULT_LANG,
  LANGS,
  LANG_TAG,
  isEnglishOnly,
  localizePath,
  neutralPath,
  type Lang,
} from '../i18n';

interface Props {
  lang?: Lang;
  /* The same two props the header takes, for the same reason: a page that
     knows where its counterpart lives has to be able to say so, and a page with
     no counterpart has to send the reader somewhere real. Base.astro passes the
     identical values to both, so the two switches can never disagree. */
  switchTo?: string;
  switchToHome?: boolean;
}

const { lang = DEFAULT_LANG, switchTo, switchToHome = false } = Astro.props;
const c = useCopy(lang);
const year = new Date().getFullYear();

const other = LANGS.find((l) => l !== lang)!;
const neutral = neutralPath(Astro.url.pathname.replace(/\/$/, '') || '/') || '/';
const otherHref =
  switchTo ??
  (switchToHome || isEnglishOnly(neutral)
    ? localizePath('/', other)
    : localizePath(neutral, other));

/* A surface with nothing in it is dropped — see the header comment. */
const empty = await emptySurfaces(lang);

/* ---- column 1: the frozen IA, in the frozen order ----------------------------
   Every one of the six renders, always, and the list is NOT filtered by
   content. That is deliberate and it is the difference between this column and
   the next one: these six are the site's navigation, they are the six the
   header carries, and a footer that quietly drops "Gear" on the day nothing is
   published would contradict the header two screens above it.

   Nor would it be protecting anyone: /vibe-coding and /gear have DESIGNED empty
   states — a header, an honest line, a footnote — so an empty pillar hub is a
   real page answering a real question. The supporting-content column below is
   different: /guides with nothing in it is an empty index, not an answer, so
   there the link is dropped until it leads somewhere. */
const PRIMARY = ['vibeCoding', 'gear', 'learn', 'playground'];
const primary = PRIMARY.map((key) => nav.find((item) => item.key === key))
  .filter((item): item is NonNullable<typeof item> => Boolean(item))
  .map((item) => ({
    key: item.key,
    href: isEnglishOnly(item.path) && lang !== 'en' ? item.path : localizePath(item.path, lang),
    /* An English-only route is linked in English and says so, rather than
       advertising an /ar/ URL that was never generated. */
    outbound: isEnglishOnly(item.path) && lang !== 'en',
    label:
      item.key === 'newsletter'
        ? c.ia.nav.subscribe
        : (c.ia.nav as Record<string, string>)[item.key] ??
          (c.nav as Record<string, string>)[item.key] ??
          item.key,
  }));

/* ---- column 2: the Learn surfaces, in the design of record's order ---- */
const SUPPORTING = ['useCases', 'prompts', 'guides', 'videos', 'series', 'topics'];
const supporting = SUPPORTING.map((key) => nav.find((item) => item.key === key))
  .filter((item): item is NonNullable<typeof item> => Boolean(item) && item!.phase <= 1.5)
  /* `series` is deliberately not gated here. It is not a content SURFACE with
     its own collection — it is a view over guides and articles carrying
     `series:` frontmatter, so `emptySurfaces()` has no count for it — and it
     has its own designed empty state either way. */
  .filter((item) => !empty.has(item.key))
  .map((item) => ({
    href: localizePath(item.path, lang),
    /* `nav.series` is labelled "Vibe Coding" — it was the Phase 1.1 name for
       the build narrative, back when the series WAS the pillar. Now that
       /vibe-coding is the pillar and sits in the column above, reusing that
       label here would print "Vibe Coding" twice in one footer, pointing at
       two different pages. The series takes its own name instead. */
    label:
      item.key === 'series'
        ? c.series.label
        : (c.nav as Record<string, string>)[item.key] ?? item.key,
  }));

/* The Prompt Library is named, unlinked, while it is genuinely closed — the
   frozen "· soon" treatment. A label is not a promise; a link would be. */
const promptsClosed = empty.has('prompts');

/* ---- column 3: the channel ---- */
const CHANNEL = ['about', 'newsletter'];
const channel = [
  ...CHANNEL.map((key) => nav.find((item) => item.key === key))
    .filter((item): item is NonNullable<typeof item> => Boolean(item))
    .map((item) => ({
      href: localizePath(item.path, lang),
      outbound: false,
      label:
        item.key === 'newsletter'
          ? c.ia.nav.subscribe
          : (c.ia.nav as Record<string, string>)[item.key] ?? item.key,
    })),
  {
    /* /contact is authored in English only, so an Arabic page links out to the
       English page and says so on the anchor rather than advertising an /ar/
       URL that was never generated. */
    href: '/contact/',
    outbound: lang !== DEFAULT_LANG,
    label: c.ia.footer.contact,
  },
];
---

<footer class="ftr">
  <div class="ftr__inner">
    <div class="ftr__brand">
      <Logo size={26} tone="primary" />
      {/* The umbrella line — what this whole site is for, in one sentence. */}
      <Rich text={c.ia.footer.umbrella} as="p" class="ftr__blurb" />
    </div>

    {/* ---- the frozen IA ---- */}
    <nav class="ftr__col" aria-label={c.ia.footer.explore}>
      <span class="ftr__title">{c.ia.footer.explore}</span>
      {primary.map((item) => (
        <a
          href={item.href}
          class="ftr__link"
          lang={item.outbound ? 'en' : undefined}
          hreflang={item.outbound ? 'en' : undefined}
        >
          <Rich text={item.label} />
        </a>
      ))}
    </nav>

    {/* ---- supporting content ---- */}
    {(supporting.length > 0 || promptsClosed) && (
      <nav class="ftr__col" aria-label={c.ia.footer.learn}>
        <span class="ftr__title" dir="ltr">{c.ia.footer.learn}</span>
        {supporting.map((item) => (
          <a href={item.href} class="ftr__link"><Rich text={item.label} /></a>
        ))}
        {promptsClosed && (
          <span class="ftr__soon"><Rich text={c.ia.footer.promptLibrary} /></span>
        )}
      </nav>
    )}

    {/* The channel column. The social accounts are NOT repeated here: they are
        rendered once, in the homepage close, beside the person whose accounts
        they are. Two rows of the same five icons on one page is not redundancy
        the reader benefits from. */}
    <nav class="ftr__col" aria-label={c.ia.footer.channel}>
      <span class="ftr__title" dir="ltr">{c.ia.footer.channel}</span>
      {channel.map((item) => (
        <a
          href={item.href}
          class="ftr__link"
          lang={item.outbound ? DEFAULT_LANG : undefined}
          hreflang={item.outbound ? DEFAULT_LANG : undefined}
        >
          <Rich text={item.label} />
        </a>
      ))}
    </nav>
  </div>

  <div class="ftr__base">
    <span dir="ltr">© {year} {c.ia.footer.rights}</span>
    <span class="ftr__baseRight">
      {/* The editorial signature sits in the credit position, never the
          identity position (§8 — the signature is a sign-off, not the mark). */}
      <span class="ftr__sig">{c.footer.signature}</span>
      {/* The language pill shows the OTHER language, written in its own script.
          The footer never animates, so this is a link and nothing more. */}
      <a class="ftr__lang" href={otherHref} lang={LANG_TAG[other]} hreflang={LANG_TAG[other]}>
        {c.common.languageSwitch}
      </a>
    </span>
  </div>
</footer>

<style>
  .ftr {
    background: var(--adel-surface-canvas);
    border-top: 1px solid var(--adel-border-hairline);
    margin-top: 120px;
  }
  .ftr__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 64px var(--atc-space-8) 40px;
    display: grid;
    grid-template-columns: 1.7fr 1fr 1fr 1.2fr;
    gap: 48px;
  }
  .ftr__brand {
    display: flex;
    flex-direction: column;
    gap: var(--atc-space-4);
  }
  .ftr__blurb {
    margin: 0;
    font-size: var(--adel-text-sm);
    line-height: 1.6;
    color: var(--adel-text-secondary);
    max-width: 38ch;
  }
  :global([lang='ar']) .ftr__blurb { line-height: 1.85; }

  .ftr__col {
    display: flex;
    flex-direction: column;
    gap: var(--atc-space-3);
    align-items: flex-start;
  }
  .ftr__title {
    font-size: var(--adel-text-xs);
    font-weight: 600;
    letter-spacing: var(--adel-tracking-wide);
    text-transform: uppercase;
    color: var(--adel-text-tertiary);
    unicode-bidi: isolate;
  }
  :global([lang='ar']) .ftr__title {
    letter-spacing: normal;
    text-transform: none;
    font-size: var(--adel-text-sm);
  }
  .ftr__link {
    font-size: var(--adel-text-sm);
    color: var(--adel-text-secondary);
    text-decoration: none;
  }
  .ftr__link:hover {
    color: var(--adel-text-link);
    text-decoration: underline;
  }
  /* Named, not linked — the surface is genuinely closed. */
  .ftr__soon {
    font-size: var(--adel-text-sm);
    color: var(--adel-text-tertiary);
  }

  .ftr__base {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--atc-space-6) var(--atc-space-8) 40px;
    border-top: 1px solid var(--adel-border-hairline);
    display: flex;
    justify-content: space-between;
    gap: var(--atc-space-4);
    font-size: var(--adel-text-xs);
    color: var(--adel-text-tertiary);
  }

  @media (max-width: 1023px) {
    .ftr__inner {
      grid-template-columns: 1fr 1fr;
      gap: var(--atc-space-10);
    }
    .ftr__brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 767px) {
    .ftr {
      margin-top: 80px;
    }
    .ftr__inner {
      grid-template-columns: 1fr;
      gap: var(--atc-space-8);
      padding: 48px var(--atc-space-5) 32px;
    }
    .ftr__base {
      padding-inline: var(--atc-space-5);
    }
    .ftr__base {
      flex-direction: column;
      gap: var(--atc-space-2);
    }
  }
</style>
