---
/* =============================================================================
   Footer — the frozen IA, and where the brand architecture is stated plainly
   =============================================================================
   ── THE PRIMARY COLUMN IS THE FROZEN IA, IN ORDER ───────────────────────────

     Vibe Coding · Gear · Learn · Playground · About · Subscribe

   The same six the header carries, in the same order, from the same `nav` list
   in site.config.ts — so the header, the mobile menu and this column cannot
   drift apart. Subscribe is last here as it is last there.

   ── SUPPORTING CONTENT KEEPS ITS PLACE ──────────────────────────────────────
   Guides, Use cases, Videos, Prompts, Topics and the Vibe Coding series are all
   still routed and still live at exactly the URLs they had. They are not
   header items — they are reached through /learn — but the footer is precisely
   where a reader goes looking for the thing that was not in the nav, so they
   are listed in a SECOND column under "More". That is supporting content, not
   restored legacy navigation: none of them re-enters the primary IA, and the
   old four-item Explore/For brands/channel arrangement is gone.

   A surface with nothing published in this language is dropped from that
   column — a link is a promise, and this one would land on an empty index. It
   returns by itself the day something publishes there.

   ── BRAND ARCHITECTURE (§5) ─────────────────────────────────────────────────
   Adel is the site. AdelTechTalks is named as the channel, in the place where
   you name a channel — beside its own social links, not beside the identity.
   GearNest is a separate business: a link out, in its own row, with visible
   distance from both. It is NOT a homepage section and NOT a dependency —
   nothing on this site reads from it or breaks without it.
   ========================================================================== */

import AdelLogo from './AdelLogo.astro';
import Icon from './Icon.astro';
import Rich from './Rich.astro';
import { site, nav, projects } from '../site.config';
import { emptySurfaces } from '../lib/content';
import { useCopy } from '../copy';
import { DEFAULT_LANG, isEnglishOnly, localizePath, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
}

const { lang = DEFAULT_LANG } = Astro.props;
const c = useCopy(lang);
const year = new Date().getFullYear();

const SOCIAL: Array<[keyof typeof site.social, string, string]> = [
  ['youtube', 'youtube', 'YouTube'],
  ['instagram', 'instagram', 'Instagram'],
  ['tiktok', 'music', 'TikTok'],
  ['linkedin', 'linkedin', 'LinkedIn'],
  ['x', 'twitter', 'X'],
];
const links = SOCIAL.filter(([key]) => site.social[key]);

/* A surface with nothing in it is dropped — see the header comment. */
const empty = await emptySurfaces(lang);

/* ---- column 1: the frozen IA, in the frozen order ----------------------------
   Every one of the six renders, always, and the list is NOT filtered by
   content. That is deliberate and it is the difference between this column and
   the next one: these six are the site's navigation, they are the six the
   header carries, and a footer that quietly drops "Gear" on the day nothing is
   published would contradict the header two screens above it.

   Nor would it be protecting anyone: /vibe-coding and /gear have DESIGNED empty
   states — a header, an honest line, a footnote — so an empty pillar hub is a
   real page answering a real question. The supporting-content column below is
   different: /guides with nothing in it is an empty index, not an answer, so
   there the link is dropped until it leads somewhere. */
const PRIMARY = ['vibeCoding', 'gear', 'learn', 'playground', 'about', 'newsletter'];
const primary = PRIMARY.map((key) => nav.find((item) => item.key === key))
  .filter((item): item is NonNullable<typeof item> => Boolean(item))
  .map((item) => ({
    key: item.key,
    href: isEnglishOnly(item.path) && lang !== 'en' ? item.path : localizePath(item.path, lang),
    /* An English-only route is linked in English and says so, rather than
       advertising an /ar/ URL that was never generated. */
    outbound: isEnglishOnly(item.path) && lang !== 'en',
    label:
      item.key === 'newsletter'
        ? c.ia.nav.subscribe
        : (c.ia.nav as Record<string, string>)[item.key] ??
          (c.nav as Record<string, string>)[item.key] ??
          item.key,
  }));

/* ---- column 2: supporting content, reached through /learn and from here ---- */
const SUPPORTING = ['series', 'guides', 'useCases', 'videos', 'prompts', 'topics'];
const supporting = SUPPORTING.map((key) => nav.find((item) => item.key === key))
  .filter((item): item is NonNullable<typeof item> => Boolean(item) && item!.phase <= 1.5)
  /* `series` is deliberately not gated here. It is not a content SURFACE with
     its own collection — it is a view over guides and articles carrying
     `series:` frontmatter, so `emptySurfaces()` has no count for it — and it
     has its own designed empty state either way. */
  .filter((item) => !empty.has(item.key))
  .map((item) => ({
    href: localizePath(item.path, lang),
    label: (c.nav as Record<string, string>)[item.key] ?? item.key,
  }));

/* The Prompt Library is named, unlinked, while it is genuinely closed — the
   frozen "· soon" treatment. A label is not a promise; a link would be. */
const promptsClosed = empty.has('prompts');

const separate = projects.filter((p) => p.separate);
---

<footer class="ftr">
  <div class="ftr__inner">
    <div class="ftr__brand">
      <AdelLogo size={26} tone="default" />
      {/* The umbrella line — what this whole site is for, in one sentence. */}
      <Rich text={c.ia.footer.umbrella} as="p" class="ftr__blurb" />
    </div>

    {/* ---- the frozen IA ---- */}
    <nav class="ftr__col" aria-label={c.ia.footer.explore}>
      <span class="ftr__title">{c.ia.footer.explore}</span>
      {primary.map((item) => (
        <a
          href={item.href}
          class="ftr__link"
          lang={item.outbound ? 'en' : undefined}
          hreflang={item.outbound ? 'en' : undefined}
        >
          <Rich text={item.label} />
        </a>
      ))}
    </nav>

    {/* ---- supporting content ---- */}
    {(supporting.length > 0 || promptsClosed) && (
      <nav class="ftr__col" aria-label={c.ia.footer.more}>
        <span class="ftr__title">{c.ia.footer.more}</span>
        {supporting.map((item) => (
          <a href={item.href} class="ftr__link"><Rich text={item.label} /></a>
        ))}
        {promptsClosed && (
          <span class="ftr__soon"><Rich text={c.ia.footer.promptLibrary} /></span>
        )}
      </nav>
    )}

    {/* The channel is named HERE, beside its own links — not beside the
        personal identity above. That separation is the whole of §5. */}
    <div class="ftr__col">
      <span class="ftr__title" dir="ltr">{site.showName}</span>
      {links.length > 0 && (
        <div class="ftr__social">
          {links.map(([key, icon, label]) => (
            <a
              href={site.social[key]}
              class="ftr__soc"
              aria-label={`${site.showName} on ${label}`}
              rel="me noopener"
              target="_blank"
            >
              <Icon name={icon} size="md" />
            </a>
          ))}
        </div>
      )}
      <a href={`mailto:${site.email}`} class="ftr__link" dir="ltr">{site.email}</a>
    </div>
  </div>

  {/* A separate business, at a visible distance from both identities. */}
  {separate.length > 0 && (
    <div class="ftr__separate">
      {separate.map((p) => (
        <a class="ftr__sepLink" href={p.url} rel="noopener" target="_blank">
          <Rich text={p[lang].name} class="ftr__sepName" />
          <span class="ftr__sepArrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  )}

  <div class="ftr__base">
    <span>© {year} {c.footer.rights}</span>
    {/* The editorial signature sits in the credit position, never the identity
        position (§8 — the signature is a sign-off, not the brand mark). */}
    <span class="ftr__sig">{c.footer.signature}</span>
  </div>
</footer>

<style>
  .ftr {
    background: var(--adel-surface-canvas);
    border-top: 1px solid var(--adel-border-hairline);
    margin-top: 120px;
  }
  .ftr__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 64px var(--atc-space-8) 40px;
    display: grid;
    grid-template-columns: 1.7fr 1fr 1fr 1.2fr;
    gap: 48px;
  }
  .ftr__brand {
    display: flex;
    flex-direction: column;
    gap: var(--atc-space-4);
  }
  .ftr__blurb {
    margin: 0;
    font-size: var(--adel-text-sm);
    line-height: 1.6;
    color: var(--adel-text-secondary);
    max-width: 38ch;
  }
  :global([lang='ar']) .ftr__blurb { line-height: 1.85; }

  .ftr__col {
    display: flex;
    flex-direction: column;
    gap: var(--atc-space-3);
    align-items: flex-start;
  }
  .ftr__title {
    font-size: var(--adel-text-xs);
    font-weight: 600;
    letter-spacing: var(--adel-tracking-wide);
    text-transform: uppercase;
    color: var(--adel-text-tertiary);
    unicode-bidi: isolate;
  }
  :global([lang='ar']) .ftr__title {
    letter-spacing: normal;
    text-transform: none;
    font-size: var(--adel-text-sm);
  }
  .ftr__link {
    font-size: var(--adel-text-sm);
    color: var(--adel-text-secondary);
    text-decoration: none;
  }
  .ftr__link:hover {
    color: var(--adel-text-link);
    text-decoration: underline;
  }
  /* Named, not linked — the surface is genuinely closed. */
  .ftr__soon {
    font-size: var(--adel-text-sm);
    color: var(--adel-text-tertiary);
  }

  .ftr__social {
    display: flex;
    gap: 2px;
    flex-wrap: wrap;
    /* pull the 44px targets back into line with the text above them */
    margin-inline-start: -10px;
  }
  .ftr__soc {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: var(--adel-radius-control);
    color: var(--adel-text-secondary);
    text-decoration: none;
  }
  .ftr__soc:hover {
    background: var(--adel-surface-tint);
    color: var(--adel-text-on-tint);
  }

  /* ---- separate brands: a row of their own, with air above and below ---- */
  .ftr__separate {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--atc-space-6) var(--atc-space-8);
    border-top: 1px solid var(--adel-border-hairline);
    display: flex;
    gap: var(--atc-space-6);
    flex-wrap: wrap;
  }
  .ftr__sepLink {
    display: inline-flex;
    align-items: center;
    gap: var(--atc-space-2);
    font-size: var(--adel-text-sm);
    color: var(--adel-text-secondary);
    text-decoration: none;
  }
  .ftr__sepName {
    font-weight: 600;
    color: var(--adel-text-primary);
  }
  .ftr__sepLink:hover .ftr__sepName {
    color: var(--adel-text-link);
  }
  /* ↗ points away from the reading direction on both sides. */
  :global([dir='rtl']) .ftr__sepArrow {
    display: inline-block;
    transform: scaleX(-1);
  }

  .ftr__base {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--atc-space-6) var(--atc-space-8) 40px;
    border-top: 1px solid var(--adel-border-hairline);
    display: flex;
    justify-content: space-between;
    gap: var(--atc-space-4);
    font-size: var(--adel-text-xs);
    color: var(--adel-text-tertiary);
  }

  @media (max-width: 1023px) {
    .ftr__inner {
      grid-template-columns: 1fr 1fr;
      gap: var(--atc-space-10);
    }
    .ftr__brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 767px) {
    .ftr {
      margin-top: 80px;
    }
    .ftr__inner {
      grid-template-columns: 1fr;
      gap: var(--atc-space-8);
      padding: 48px var(--atc-space-5) 32px;
    }
    .ftr__separate,
    .ftr__base {
      padding-inline: var(--atc-space-5);
    }
    .ftr__base {
      flex-direction: column;
      gap: var(--atc-space-2);
    }
  }
</style>
