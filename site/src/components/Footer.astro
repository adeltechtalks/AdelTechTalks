---
/* =============================================================================
   Footer — where the brand architecture is stated plainly (§5)
   =============================================================================
   Adel is the site. AdelTechTalks is named as the channel, in the place where
   you name a channel — next to its social links, not next to the identity.
   GearNest is a link out, in its own row, with visible distance from both.
   ========================================================================== */

import AdelLogo from './AdelLogo.astro';
import Icon from './Icon.astro';
import Rich from './Rich.astro';
import { site, nav, projects } from '../site.config';
import { useCopy } from '../copy';
import { DEFAULT_LANG, localizePath, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
}

const { lang = DEFAULT_LANG } = Astro.props;
const c = useCopy(lang);
const year = new Date().getFullYear();

const SOCIAL: Array<[keyof typeof site.social, string, string]> = [
  ['youtube', 'youtube', 'YouTube'],
  ['instagram', 'instagram', 'Instagram'],
  ['tiktok', 'music', 'TikTok'],
  ['linkedin', 'linkedin', 'LinkedIn'],
  ['x', 'twitter', 'X'],
];
const links = SOCIAL.filter(([key]) => site.social[key]);

/* Phase 1.1 — the header carries five items; the footer carries the whole
   ecosystem, because that is where a reader goes looking for the thing that was
   not in the nav. Order is deliberate: the hub, the series, then each content
   type, then the Playground.

   `phase <= 1.5` is everything routed and live. Phase 2 and 3 entries stay
   defined and unrendered exactly as before. */
const exploreKeys = [
  'learn', 'series', 'guides', 'useCases', 'videos', 'prompts', 'topics',
  'playground', 'newsletter',
];
const explore = exploreKeys
  .map((key) => nav.find((item) => item.key === key))
  .filter((item): item is NonNullable<typeof item> => Boolean(item) && item!.phase <= 1.5)
  .map((item) => ({
    href: localizePath(item.path, lang),
    label: (c.nav as Record<string, string>)[item.key] ?? item.key,
  }));

const separate = projects.filter((p) => p.separate);
---

<footer class="ftr">
  <div class="ftr__inner">
    <div class="ftr__brand">
      <AdelLogo size={26} tone="default" />
      <Rich text={c.footer.blurb} as="p" class="ftr__blurb" />
    </div>

    <div class="ftr__col">
      <span class="ftr__title">{c.footer.explore}</span>
      {explore.map((item) => (
        <a href={item.href} class="ftr__link"><Rich text={item.label} /></a>
      ))}
      <a href={localizePath('/about', lang)} class="ftr__link">{c.nav.about}</a>
    </div>

    <div class="ftr__col">
      <span class="ftr__title">{c.footer.brands}</span>
      <a href={localizePath('/work-with-me', lang)} class="ftr__link">{c.nav.work}</a>
      <a href={`mailto:${site.email}`} class="ftr__link">{site.email}</a>
    </div>

    {/* The channel is named HERE, beside its own links — not beside the
        personal identity above. That separation is the whole of §5. */}
    <div class="ftr__col">
      <span class="ftr__title">{site.showName}</span>
      {links.length > 0 && (
        <div class="ftr__social">
          {links.map(([key, icon, label]) => (
            <a
              href={site.social[key]}
              class="ftr__soc"
              aria-label={`${site.showName} on ${label}`}
              rel="me noopener"
              target="_blank"
            >
              <Icon name={icon} size="md" />
            </a>
          ))}
        </div>
      )}
    </div>
  </div>

  {separate.length > 0 && (
    <div class="ftr__separate">
      {separate.map((p) => (
        <a class="ftr__sepLink" href={p.url} rel="noopener" target="_blank">
          <Rich text={p[lang].name} class="ftr__sepName" />
          <span class="ftr__sepArrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  )}

  <div class="ftr__base">
    <span>© {year} {c.footer.rights}</span>
    {/* The editorial signature sits in the credit position, never the identity
        position (§8 — the signature is a sign-off, not the brand mark). */}
    <span class="ftr__sig">{c.footer.signature}</span>
  </div>
</footer>

<style>
  .ftr {
    background: var(--adel-surface-canvas);
    border-top: 1px solid var(--adel-border-hairline);
    margin-top: 120px;
  }
  .ftr__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 64px var(--atc-space-8) 40px;
    display: grid;
    grid-template-columns: 1.7fr 1fr 1.1fr 1.2fr;
    gap: 48px;
  }
  .ftr__brand {
    display: flex;
    flex-direction: column;
    gap: var(--atc-space-4);
  }
  .ftr__blurb {
    margin: 0;
    font-size: var(--adel-text-sm);
    line-height: 1.6;
    color: var(--adel-text-secondary);
    max-width: 38ch;
  }
  .ftr__col {
    display: flex;
    flex-direction: column;
    gap: var(--atc-space-3);
    align-items: flex-start;
  }
  .ftr__title {
    font-size: var(--adel-text-xs);
    font-weight: 600;
    letter-spacing: var(--adel-tracking-wide);
    text-transform: uppercase;
    color: var(--adel-text-tertiary);
  }
  .ftr__link {
    font-size: var(--adel-text-sm);
    color: var(--adel-text-secondary);
    text-decoration: none;
  }
  .ftr__link:hover {
    color: var(--adel-text-link);
    text-decoration: underline;
  }
  .ftr__social {
    display: flex;
    gap: 2px;
    flex-wrap: wrap;
    /* pull the 44px targets back into line with the text above them */
    margin-inline-start: -10px;
  }
  .ftr__soc {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: var(--adel-radius-control);
    color: var(--adel-text-secondary);
    text-decoration: none;
  }
  .ftr__soc:hover {
    background: var(--adel-surface-tint);
    color: var(--adel-text-on-tint);
  }

  /* ---- separate brands: a row of their own, with air above and below ---- */
  .ftr__separate {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--atc-space-6) var(--atc-space-8);
    border-top: 1px solid var(--adel-border-hairline);
    display: flex;
    gap: var(--atc-space-6);
    flex-wrap: wrap;
  }
  .ftr__sepLink {
    display: inline-flex;
    align-items: center;
    gap: var(--atc-space-2);
    font-size: var(--adel-text-sm);
    color: var(--adel-text-secondary);
    text-decoration: none;
  }
  .ftr__sepName {
    font-weight: 600;
    color: var(--adel-text-primary);
  }
  .ftr__sepLink:hover .ftr__sepName {
    color: var(--adel-text-link);
  }
  /* ↗ points away from the reading direction on both sides. */
  [dir='rtl'] .ftr__sepArrow {
    display: inline-block;
    transform: scaleX(-1);
  }

  .ftr__base {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--atc-space-6) var(--atc-space-8) 40px;
    border-top: 1px solid var(--adel-border-hairline);
    display: flex;
    justify-content: space-between;
    gap: var(--atc-space-4);
    font-size: var(--adel-text-xs);
    color: var(--adel-text-tertiary);
  }

  @media (max-width: 1023px) {
    .ftr__inner {
      grid-template-columns: 1fr 1fr;
      gap: var(--atc-space-10);
    }
    .ftr__brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 767px) {
    .ftr {
      margin-top: 80px;
    }
    .ftr__inner {
      grid-template-columns: 1fr;
      gap: var(--atc-space-8);
      padding: 48px var(--atc-space-5) 32px;
    }
    .ftr__separate,
    .ftr__base {
      padding-inline: var(--atc-space-5);
    }
    .ftr__base {
      flex-direction: column;
      gap: var(--atc-space-2);
    }
  }
</style>
