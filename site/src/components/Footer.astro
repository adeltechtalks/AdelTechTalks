---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { site } from '../site.config';

const year = new Date().getFullYear();

const SOCIAL: Array<[keyof typeof site.social, string, string]> = [
  ['youtube', 'youtube', 'YouTube'],
  ['instagram', 'instagram', 'Instagram'],
  ['tiktok', 'music', 'TikTok'],
  ['linkedin', 'linkedin', 'LinkedIn'],
  ['x', 'twitter', 'X'],
];

const links = SOCIAL.filter(([key]) => site.social[key]);

const COLUMNS = [
  { title: 'Explore', items: [['Guides', '/guides'], ['Playground', '/playground'], ['About', '/about']] },
  { title: 'For brands', items: [['Work with me', '/work-with-me'], ['Packages', '/work-with-me#packages'], ['Contact', '/contact']] },
];
---

<footer class="ftr">
  <div class="ftr__inner">
    <div class="ftr__brand">
      <Logo size={32} />
      <p class="ftr__blurb">{site.description}</p>
      {links.length > 0 && (
        <div class="ftr__social">
          {links.map(([key, icon, label]) => (
            <a href={site.social[key]} class="ftr__soc" aria-label={label} rel="me noopener" target="_blank">
              <Icon name={icon} size="md" />
            </a>
          ))}
        </div>
      )}
    </div>

    {COLUMNS.map((col) => (
      <div class="ftr__col">
        <span class="ftr__title">{col.title}</span>
        {col.items.map(([label, href]) => (
          <a href={href} class="ftr__link">{label}</a>
        ))}
      </div>
    ))}
  </div>

  <div class="ftr__base">
    <span>© {year} {site.name}</span>
    <!-- The editorial signature sits in the credit position, never the identity position. -->
    <span class="ftr__sig">Curated by Adel.</span>
  </div>
</footer>

<style>
  .ftr {
    background: var(--atc-surface-sunken);
    border-top: var(--atc-stroke-hairline) solid var(--atc-ink-100);
    margin-top: 96px;
  }
  .ftr__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 64px var(--atc-space-8) 48px;
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 48px;
  }
  .ftr__brand {
    display: flex;
    flex-direction: column;
    gap: var(--atc-space-4);
  }
  .ftr__blurb {
    margin: 0;
    font-size: var(--atc-body-small-size);
    line-height: var(--atc-body-small-line);
    color: var(--atc-ink-500);
    max-width: 40ch;
  }
  .ftr__social {
    display: flex;
    gap: var(--atc-space-2);
    margin-top: var(--atc-space-2);
  }
  .ftr__soc {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: var(--atc-radius-control);
    color: var(--atc-ink-700);
    text-decoration: none;
  }
  .ftr__soc:hover {
    background: var(--atc-purple-50);
    color: var(--atc-purple-600);
  }
  .ftr__col {
    display: flex;
    flex-direction: column;
    gap: var(--atc-space-3);
  }
  .ftr__title {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--atc-ink-500);
  }
  .ftr__link {
    font-size: var(--atc-body-small-size);
    color: var(--atc-ink-700);
    text-decoration: none;
  }
  .ftr__link:hover {
    color: var(--atc-purple-700);
    text-decoration: underline;
  }
  .ftr__base {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--atc-space-8) 40px;
    display: flex;
    justify-content: space-between;
    gap: var(--atc-space-4);
    font-size: 12px;
    color: var(--atc-ink-500);
  }
  .ftr__sig {
    font-style: italic;
  }

  @media (max-width: 767px) {
    .ftr__inner {
      grid-template-columns: 1fr;
      gap: var(--atc-space-8);
      padding: 48px var(--atc-space-5) 32px;
    }
    .ftr__base {
      padding: 0 var(--atc-space-5) 32px;
      flex-direction: column;
      gap: var(--atc-space-2);
    }
  }
</style>
