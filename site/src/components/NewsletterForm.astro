---
/* =============================================================================
   Newsletter signup — real, working, on the site's own database (§20)
   =============================================================================
   States: idle · sending · success · already-subscribed · invalid · error.
   Every one of them is announced to assistive technology through a live
   region, because a form that only changes colour has not told a screen-reader
   user anything.

   Configuration reaches the browser through data attributes, never through
   Astro's `define:vars` — define:vars implies is:inline, which stops the script
   being bundled, which silently breaks every import in it.
   ========================================================================== */

import Button from './Button.astro';
import Rich from './Rich.astro';
import { services, site } from '../site.config';
import { plain, useCopy } from '../copy';
import { DEFAULT_LANG, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
  /* Where this instance sits — stored with the subscriber so Adel can see
     which surface actually converts. */
  placement?: string;
  compact?: boolean;
  /* `inverse` restyles the form for a graphite ground. It changes NOTHING
     about the write path, the states or the live region — the closing section
     on the homepage sits on the dark panel, and a second copy of this form
     would be a second copy of the Supabase call to keep in sync. */
  tone?: 'default' | 'inverse';
  /* The homepage §6 panel authors its own placeholder, button and messages in
     `ia.about`. Anything not overridden falls back to the shared newsletter
     copy, so the /newsletter page is untouched by this. */
  copy?: Partial<{
    placeholder: string;
    submit: string;
    note: string;
    sending: string;
    success: string;
    already: string;
    invalid: string;
    error: string;
  }>;
  class?: string;
}

const {
  lang = DEFAULT_LANG,
  placement = 'page',
  compact = false,
  tone = 'default',
  copy: overrides = {},
  class: className,
} = Astro.props;
const base = useCopy(lang);
/* One merged object, so every reference below reads the same way whether or
   not the caller overrode anything. */
const c = { ...base, newsletter: { ...base.newsletter, ...overrides } };

const live = Boolean(services.supabaseUrl && services.supabaseAnonKey);
const id = `nl-${placement}`;
---

<div class:list={['nl', compact && 'nl--compact', tone === 'inverse' && 'nl--inverse', className]} data-nl-root>
  {live ? (
    <form
      class="nl__form"
      data-nl-form
      data-supabase-url={services.supabaseUrl}
      data-supabase-key={services.supabaseAnonKey}
      data-lang={lang}
      data-placement={placement}
      {/* §11 — every message below is written into an ATTRIBUTE and then set
          as textContent by the script, so a [[term]] marker in it would ship
          literal double brackets to the reader. `plain()` flattens the marker
          the way Rich would render it. */}
      data-msg-ok={plain(c.newsletter.success)}
      data-msg-already={plain(c.newsletter.already)}
      data-msg-invalid={plain(c.newsletter.invalid)}
      data-msg-error={plain(c.newsletter.error)}
      data-msg-sending={plain(c.newsletter.sending)}
      novalidate
    >
      <label class="nl__label" for={id}><Rich text={c.newsletter.label} /></label>
      <div class="nl__row">
        <input
          class="nl__input"
          id={id}
          type="email"
          name="email"
          required
          autocomplete="email"
          inputmode="email"
          spellcheck="false"
          placeholder={plain(c.newsletter.placeholder)}
          aria-describedby={`${id}-status ${id}-consent`}
          data-nl-input
        />
        <Button variant="primary" size="md" type="submit" data-nl-submit>
          <Rich text={c.newsletter.submit} />
        </Button>
      </div>

      {/* Honeypot. A real person never sees or fills this; a bot fills every
          field it finds. Cheaper and more private than a captcha. */}
      <div class="nl__trap" aria-hidden="true">
        <label for={`${id}-company`}>Company</label>
        <input id={`${id}-company`} type="text" name="company" tabindex="-1" autocomplete="off" />
      </div>

      <Rich text={c.newsletter.consent} as="p" class="nl__note" id={`${id}-consent`} />

      {/* role=status is polite: it does not interrupt, but it is announced. */}
      <p class="nl__status" id={`${id}-status`} role="status" aria-live="polite" data-nl-status></p>

      <Rich text={c.newsletter.note} as="p" class="nl__note nl__note--fine" />

      <noscript>
        <p class="nl__note">
          This form needs JavaScript. Email <a href={`mailto:${site.email}`}>{site.email}</a> and
          I will add you by hand.
        </p>
      </noscript>
    </form>
  ) : (
    <div class="nl__pending">
      <p class="nl__pendingTitle">Newsletter not connected</p>
      <p class="nl__note">
        Add <code>supabaseUrl</code> and <code>supabaseAnonKey</code> to
        <code>src/site.config.ts</code>.
      </p>
    </div>
  )}
</div>

<script>
  import { subscribe, isValidEmail } from '../lib/newsletter';
  import { capture } from '../lib/attribution';

  /* One capture per page load, before any form is touched (§21). */
  capture();

  for (const form of document.querySelectorAll<HTMLFormElement>('[data-nl-form]')) {
    const input = form.querySelector<HTMLInputElement>('[data-nl-input]')!;
    const status = form.querySelector<HTMLElement>('[data-nl-status]')!;
    const submit = form.querySelector<HTMLElement>('[data-nl-submit]')!;
    const trap = form.querySelector<HTMLInputElement>('input[name="company"]');

    const d = form.dataset;
    const setState = (state: string, message: string) => {
      form.dataset.state = state;
      status.textContent = message;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (form.dataset.state === 'sending') return;

      /* Bot filled the honeypot. Show success, store nothing. */
      if (trap?.value) {
        setState('ok', d.msgOk ?? '');
        return;
      }

      const email = input.value;
      if (!isValidEmail(email)) {
        setState('invalid', d.msgInvalid ?? '');
        input.focus();
        return;
      }

      setState('sending', d.msgSending ?? '');
      submit.setAttribute('aria-disabled', 'true');

      const result = await subscribe({
        email,
        lang: d.lang ?? 'en',
        placement: d.placement,
        supabaseUrl: d.supabaseUrl!,
        supabaseAnonKey: d.supabaseKey!,
      });

      submit.removeAttribute('aria-disabled');

      if (result === 'ok') {
        setState('ok', d.msgOk ?? '');
        input.value = '';
      } else if (result === 'already') {
        setState('already', d.msgAlready ?? '');
        input.value = '';
      } else if (result === 'invalid') {
        setState('invalid', d.msgInvalid ?? '');
      } else {
        setState('error', d.msgError ?? '');
      }
    });

    /* Clear an error the moment they start fixing it. */
    input.addEventListener('input', () => {
      if (form.dataset.state === 'invalid' || form.dataset.state === 'error') {
        setState('', '');
      }
    });
  }
</script>

<style>
  .nl__form {
    display: flex;
    flex-direction: column;
    gap: var(--atc-space-3);
  }
  /* A placeholder is never a label — but the label may be visually hidden
     where the surrounding heading already names the field. */
  .nl__label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  .nl__row {
    display: flex;
    gap: var(--atc-space-3);
    flex-wrap: wrap;
  }
  .nl__input {
    flex: 1 1 260px;
    height: var(--atc-control-md);
    padding: 0 var(--atc-space-4);
    box-sizing: border-box;
    font-family: var(--adel-font-text);
    font-size: var(--adel-text-base);
    color: var(--adel-text-primary);
    background: var(--adel-surface-raised);
    border: 1px solid var(--adel-border-strong);
    border-radius: var(--adel-radius-control);
    /* An email address is an LTR run in any language. */
    direction: ltr;
    text-align: start;
  }
  :global([dir='rtl']) .nl__input {
    text-align: right;
  }
  .nl__input::placeholder {
    color: var(--adel-text-tertiary);
  }
  .nl__input:hover {
    border-color: var(--adel-text-tertiary);
  }

  /* The honeypot is hidden from sight and from assistive technology, but it is
     NOT display:none — some bots skip those. */
  .nl__trap {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .nl__note {
    margin: 0;
    font-size: var(--adel-text-sm);
    line-height: 1.5;
    color: var(--adel-text-secondary);
  }
  .nl__note--fine {
    font-size: var(--adel-text-xs);
    color: var(--adel-text-tertiary);
  }

  /* Empty until something happens, so it takes no space and reads nothing. */
  .nl__status:empty {
    display: none;
  }
  .nl__status {
    margin: 0;
    font-size: var(--adel-text-sm);
    font-weight: 500;
    padding: var(--atc-space-3) var(--atc-space-4);
    border-radius: var(--adel-radius-control);
    background: var(--adel-surface-sunken);
    color: var(--adel-text-primary);
  }
  /* State is carried by an icon and by the wording as well as by colour — a
     colour-only signal is not a signal for everybody. */
  .nl__status::before {
    margin-inline-end: var(--atc-space-2);
  }
  [data-state='ok'] .nl__status {
    background: var(--adel-status-success-bg);
    color: var(--adel-status-success-text);
  }
  [data-state='ok'] .nl__status::before {
    content: '✓';
  }
  [data-state='already'] .nl__status::before {
    content: '✓';
  }
  [data-state='invalid'] .nl__status,
  [data-state='error'] .nl__status {
    background: var(--adel-status-error-bg);
    color: var(--adel-status-error);
  }
  [data-state='invalid'] .nl__status::before,
  [data-state='error'] .nl__status::before {
    content: '!';
    font-weight: 700;
  }
  [data-state='invalid'] .nl__input {
    border-color: var(--adel-status-error);
  }
  [data-state='sending'] .nl__status {
    animation: atc-indeterminate var(--atc-loop-indeterminate) infinite;
  }

  /* ---------------------------------------------------------------------------
     Inverse — the same form on a graphite ground
     ---------------------------------------------------------------------------
     Colour only. Every state, message, aria-live announcement and network call
     is the default form's; this block just repaints them so they pass contrast
     on ink-900, where the light-surface tokens do not.

     The success and error grounds are re-derived rather than reused: the light
     `--adel-status-*-bg` tokens are pale washes designed to sit on white, and
     on graphite they read as a white box. A translucent tint of the same hue
     keeps the state's MEANING and its contrast at once.
     ------------------------------------------------------------------------ */
  .nl--inverse .nl__input {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.22);
    color: var(--adel-white);
  }
  .nl--inverse .nl__input::placeholder { color: rgba(255, 255, 255, 0.45); }
  .nl--inverse .nl__input:hover { border-color: rgba(255, 255, 255, 0.4); }
  .nl--inverse .nl__note { color: rgba(255, 255, 255, 0.62); }
  .nl--inverse .nl__note--fine { color: rgba(255, 255, 255, 0.45); }
  .nl--inverse .nl__note a { color: var(--adel-blue-300); }

  .nl--inverse .nl__status {
    background: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.9);
  }
  .nl--inverse [data-state='ok'] .nl__status,
  .nl--inverse [data-state='already'] .nl__status {
    background: rgba(94, 234, 190, 0.14);
    color: var(--adel-mint-500);
  }
  .nl--inverse [data-state='invalid'] .nl__status,
  .nl--inverse [data-state='error'] .nl__status {
    background: rgba(255, 138, 138, 0.14);
    color: #ff9d9d;
  }
  .nl--inverse [data-state='invalid'] .nl__input { border-color: #ff9d9d; }

  .nl--inverse .nl__pending {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.25);
    color: rgba(255, 255, 255, 0.86);
  }
  .nl--inverse .nl__pending code { background: rgba(255, 255, 255, 0.12); }

  .nl__pending {
    padding: var(--atc-space-4);
    border: 1px dashed var(--adel-border-strong);
    border-radius: var(--adel-radius-control);
    background: var(--adel-surface-raised);
  }
  .nl__pendingTitle {
    margin: 0 0 var(--atc-space-2);
    font-weight: 600;
    font-size: var(--adel-text-sm);
  }
  .nl__pending code {
    font-size: 12px;
    background: var(--adel-surface-tint);
    padding: 1px 5px;
    border-radius: var(--adel-radius-inline);
  }
</style>
