---
/* Card — values verbatim from components/surfaces/Card.jsx.
   White, radius 14, 1px hairline in ink 100, elevation 1, 24px padding.
   Interactive cards raise to elevation 2 on hover. Shadows are violet, never black. */

interface Props {
  interactive?: boolean;
  elevation?: 0 | 1 | 2 | 3 | 4;
  href?: string;
  padding?: string;
  class?: string;
  [key: string]: any;
}

const {
  interactive = false,
  elevation = 1,
  href,
  padding,
  class: className,
  ...rest
} = Astro.props;

const Tag = href ? 'a' : 'div';
const isInteractive = interactive || Boolean(href);
---

<Tag
  class:list={['atc-card', isInteractive && 'atc-card--interactive', className]}
  href={href}
  style={[
    padding ? `padding:${padding}` : null,
    elevation === 0 ? 'box-shadow:none' : `box-shadow:var(--atc-elevation-${elevation})`,
  ]
    .filter(Boolean)
    .join(';')}
  {...rest}
>
  <slot />
</Tag>

<style>
  .atc-card {
    display: flex;
    flex-direction: column;
    gap: var(--atc-space-3);
    box-sizing: border-box;
    padding: var(--atc-space-6);
    background: var(--atc-surface-raised);
    border: var(--atc-stroke-hairline) solid var(--atc-ink-100);
    border-radius: var(--atc-radius-card);
    color: inherit;
    transition: box-shadow var(--atc-duration-fast) var(--atc-ease-move);
  }
  .atc-card--interactive {
    text-align: start;
    width: 100%;
    cursor: pointer;
    text-decoration: none;
  }
  .atc-card--interactive:hover {
    box-shadow: var(--atc-elevation-2) !important;
  }
  @media (prefers-reduced-motion: reduce) {
    .atc-card {
      transition: none;
    }
  }
</style>
