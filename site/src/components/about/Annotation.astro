---
/* =============================================================================
   A handwritten annotation — About Me Storyboard, frame 3e
   =============================================================================
   "annotation — Caveat 500/600, ≥18px, blue-700 / blue-300 on dark"
   "Arabic sketch layer uses KO Ghorab (no Latin cursive for Arabic text)"

   Two faces, one component. Caveat is the ONLY font this whole pass adds, it is
   used for nothing but this layer, and it is never applied to Arabic — a Latin
   cursive face has no Arabic and would fall back to something arbitrary.
   Arabic annotations take KO Ghorab, which is the Arabic display face the
   system already loads.

   ── THE SWAP-IN POINT FOR REAL HANDWRITING ──────────────────────────────────
   The freeze calls the handwriting asset OPTIONAL: "production replaces Caveat
   with real handwriting asset if/when supplied (optional publish upgrade, not a
   gate)". When it lands, it becomes one @font-face and one changed value of
   `--adel-font-hand` in tokens/adel-type.css. Nothing in this component or its
   callers changes.

   Decorative by default — the prose beside an annotation always carries the
   same fact. Pass `informative` on the rare occasion the words are the only
   place something is said, and it is announced instead of hidden.
   ========================================================================== */

import Rich from '../Rich.astro';

interface Props {
  text: string;
  onDark?: boolean;
  informative?: boolean;
  class?: string;
}

const { text, onDark = false, informative = false, class: className, ...rest } = Astro.props;
---

<span
  class:list={['ann', onDark && 'ann--dark', className]}
  aria-hidden={informative ? undefined : 'true'}
  {...rest}
>
  <Rich text={text} />
</span>

<style>
  .ann {
    display: inline-block;
    font-family: var(--adel-font-hand);
    font-weight: 600;
    /* 3e: never below 18px. It does not scale down; below 360px the whole
       sketch layer is hidden instead (see Sketch.astro). */
    font-size: 18px;
    line-height: 1.3;
    color: var(--adel-blue-700);
    /* Handwriting is never letter-spaced or uppercased. */
    letter-spacing: normal;
    text-transform: none;
  }
  .ann--dark { color: var(--adel-blue-300); }

  /* Arabic takes the Arabic display face, at the size the display scale sets
     for a small display run — never a Latin cursive, never below the 24px floor
     Ghorab is licensed and drawn for. */
  :global(html[lang='ar']) .ann {
    font-family: var(--adel-font-arabic-display);
    font-weight: 400;
    font-size: 24px;
    font-synthesis-weight: none;
  }

  @media (max-width: 359px) {
    .ann { display: none; }
  }
</style>
