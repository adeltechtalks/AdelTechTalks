---
/* =============================================================================
   Site header — the one glass surface on the site (§17)
   =============================================================================
   §17: "Liquid Glass is an accent, not the entire website… The primary glass
   element should remain the approved navigation/chrome treatment."

   So this is it. Nothing else on any page uses backdrop-filter. If a second
   glass container appears anywhere, that is the budget being spent without a
   decision.

   The header actions stay SECONDARY: the header persists across every route,
   and a primary button here would compete with each page's own single primary
   action on every screen.
   ========================================================================== */

import Logo from './Logo.astro';
import AuthNav from './AuthNav.astro';
import Rich from './Rich.astro';
import { nav, site } from '../site.config';
import { useCopy } from '../copy';
import {
  DEFAULT_LANG,
  LANGS,
  LANG_TAG,
  isEnglishOnly,
  localizePath,
  neutralPath,
  type Lang,
} from '../i18n';

interface Props {
  lang?: Lang;
  /* Where the language switch should go, when the page knows better than the
     path does. A guide with an Arabic translation passes that translation's
     real URL, which is not the English slug with /ar in front of it. */
  switchTo?: string;
  /* The page exists in this language only. The switch then goes to the other
     language's home — a reader who taps it should land somewhere real. */
  switchToHome?: boolean;
}

const { lang = DEFAULT_LANG, switchTo, switchToHome = false } = Astro.props;
const c = useCopy(lang);

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const neutral = neutralPath(path) || '/';

/* Phase 1 only. Everything else in `nav` is defined but not rendered — the
   shape of the future navigation already exists, it is just not switched on. */
const items = nav
  .filter((item) => item.phase === 1)
  .map((item) => ({
    href: localizePath(item.path, lang),
    label: (c.nav as Record<string, string>)[item.key] ?? item.key,
    active: neutral === item.path || neutral.startsWith(item.path + '/'),
    /* An Arabic page linking to an English-only route has to announce the
       language change on the anchor, or a screen reader reads English words in
       an Arabic voice. */
    foreign: lang !== DEFAULT_LANG && isEnglishOnly(item.path),
  }));

const other = LANGS.find((l) => l !== lang)!;
/* Three cases, in order: the page told us where its counterpart is; the page
   told us it has none; or the path can be translated mechanically. The last one
   still has to handle an English-only route, which has no Arabic address at all
   — there the switch goes to that language's home rather than nowhere. */
const otherHref =
  switchTo ??
  (switchToHome || isEnglishOnly(neutral)
    ? localizePath('/', other)
    : localizePath(neutral, other));
const homeHref = localizePath('/', lang);
---

<header class="hdr">
  <div class="hdr__inner">
    {/* The approved AdelTechTalks lockup from the Design System — the locked
        mark geometry plus the wordmark, in the documented `reversed` role for a
        dark ground. Not a new logo and not a redraw: Logo.astro carries the
        exact path from atc-mark-currentcolor.svg.

        The accessible name is the CHANNEL, because that is what the lockup
        says. Brand architecture is unchanged — Adel remains the site's subject;
        AdelTechTalks is the recognisable identity that carries it. */}
    <a href={homeHref} class="hdr__logo" aria-label={`${site.showName} — ${c.common.home}`}>
      <Logo size={28} tone="reversed" />
    </a>

    <nav class="hdr__nav" aria-label="Main">
      {items.map((item) => (
        <a
          href={item.href}
          class:list={['hdr__link', item.active && 'hdr__link--active']}
          aria-current={item.active ? 'page' : undefined}
          hreflang={item.foreign ? LANG_TAG[DEFAULT_LANG] : undefined}
        >
          <Rich text={item.label} />
        </a>
      ))}
    </nav>

    <div class="hdr__actions">
      {/* IA v2.0: Subscribe is the one filled action in the chrome. It is a
          nav destination like the rest — it just carries the weight, because
          it is the only thing in the header asking for something. */}
      <a class="hdr__subscribe" href={localizePath('/newsletter', lang)}>
        <Rich text={c.ia.nav.subscribe} />
      </a>
      <AuthNav lang={lang} />
      {/* The language switch is a link to the same page, not a dropdown: one
          tap, no menu, and it works with JavaScript switched off. `lang` and
          `hreflang` on the anchor tell a screen reader the destination is in
          another language before it is announced in the wrong voice. */}
      <a class="hdr__lang" href={otherHref} lang={LANG_TAG[other]} hreflang={LANG_TAG[other]}>
        {c.common.languageSwitch}
      </a>
    </div>

    <button
      class="hdr__burger"
      aria-label={c.common.menuOpen}
      data-label-open={c.common.menuOpen}
      data-label-close={c.common.menuClose}
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <span></span><span></span><span></span>
    </button>
  </div>

  <nav class="hdr__mobile" id="mobile-nav" aria-label="Main" hidden>
    {items.map((item) => (
      <a
        href={item.href}
        class:list={['hdr__link', item.active && 'hdr__link--active']}
        hreflang={item.foreign ? LANG_TAG[DEFAULT_LANG] : undefined}
      >
        <Rich text={item.label} />
      </a>
    ))}
    <a href={localizePath('/login', lang)} class="hdr__link hdr__link--account" data-m-auth-out>
      {c.common.signIn}
    </a>
    <a href={localizePath('/profile', lang)} class="hdr__link hdr__link--account" data-m-auth-in hidden>
      {c.common.profile}
    </a>
    <a class="hdr__link hdr__link--lang" href={otherHref} lang={LANG_TAG[other]} hreflang={LANG_TAG[other]}>
      {c.common.languageSwitch}
    </a>
  </nav>
</header>

<script>
  const burger = document.querySelector<HTMLButtonElement>('.hdr__burger');
  const menu = document.querySelector<HTMLElement>('.hdr__mobile');

  /* Mirror the header's account state into the mobile menu. Same cheap
     localStorage read as AuthNav — no SDK, no network. */
  const authEl = document.querySelector<HTMLElement>('[data-auth]');
  const ref = authEl?.dataset.ref;
  if (ref) {
    try {
      const raw = localStorage.getItem(`sb-${ref}-auth-token`);
      const session = raw ? JSON.parse(raw) : null;
      if (session && (!session.expires_at || session.expires_at * 1000 > Date.now())) {
        document.querySelector<HTMLElement>('[data-m-auth-out]')?.setAttribute('hidden', '');
        document.querySelector<HTMLElement>('[data-m-auth-in]')?.removeAttribute('hidden');
      }
    } catch {}
  }

  /* The bar lifts off the page only once there is content under it. Passive
     listener, one class toggle, no layout read beyond scrollY. */
  const header = document.querySelector<HTMLElement>('.hdr');
  const setScrolled = () => header?.classList.toggle('hdr--scrolled', window.scrollY > 4);
  setScrolled();
  window.addEventListener('scroll', setScrolled, { passive: true });

  burger?.addEventListener('click', () => {
    const open = burger.getAttribute('aria-expanded') === 'true';
    burger.setAttribute('aria-expanded', String(!open));
    burger.setAttribute(
      'aria-label',
      (open ? burger.dataset.labelOpen : burger.dataset.labelClose) ?? ''
    );
    if (menu) menu.hidden = open;
  });

  /* Escape closes it and returns focus to the button — a menu you can open
     with the keyboard has to be closable with the keyboard. */
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || !burger || !menu || menu.hidden) return;
    menu.hidden = true;
    burger.setAttribute('aria-expanded', 'false');
    burger.setAttribute('aria-label', burger.dataset.labelOpen ?? '');
    burger.focus();
  });
</script>

<style>
  /* ---- the graphite bar --------------------------------------------------
     Graphite base, restrained blur, a one-pixel highlight along the top edge
     and a dark rule along the bottom. No gradient, no glow: the depth is the
     blur and the shadow, and the shadow only exists once the page has moved. */
  .hdr {
    position: sticky;
    top: 0;
    z-index: var(--atc-z-3);
    background: var(--adel-glass-fill);
    backdrop-filter: blur(var(--adel-glass-blur)) saturate(1.2);
    -webkit-backdrop-filter: blur(var(--adel-glass-blur)) saturate(1.2);
    border-top: 1px solid var(--adel-glass-border);
    border-bottom: 1px solid var(--adel-glass-edge);
    transition: box-shadow var(--atc-duration-fast) var(--atc-ease-move);
  }
  .hdr--scrolled {
    box-shadow: var(--adel-glass-shadow);
  }
  /* Where backdrop-filter is unavailable the fill must become fully opaque, or
     page text scrolls through the bar and nothing on it stays legible. */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .hdr {
      background: var(--adel-graphite);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hdr { transition: none; }
  }

  .hdr__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--atc-space-8);
    height: 68px;
    display: flex;
    align-items: center;
    gap: var(--atc-space-8);
  }
  .hdr__logo {
    display: flex;
    text-decoration: none;
  }
  .hdr__nav {
    display: flex;
    gap: 2px;
    margin-inline-start: auto;
  }
  .hdr__link {
    position: relative;
    padding: 8px 12px;
    border-radius: var(--adel-radius-control);
    text-decoration: none;
    font-size: var(--adel-text-sm);
    font-weight: 500;
    color: var(--adel-nav-fg);
    white-space: nowrap;
  }
  .hdr__link:hover {
    background: var(--adel-nav-bg-hover);
    color: var(--adel-nav-fg-hover);
  }
  /* The active item is carried by weight and a full-white label — both survive
     greyscale. The Signature Blue rule under it is a graphic accent at 3.37:1
     on Graphite, which clears the 3:1 floor for non-text UI and is never asked
     to do the work of a label. */
  .hdr__link--active {
    color: var(--adel-nav-fg-strong);
    font-weight: 600;
  }
  .hdr__link--active::after {
    content: '';
    position: absolute;
    inset-inline: 12px;
    bottom: 2px;
    height: 2px;
    border-radius: 2px;
    background: var(--adel-nav-indicator);
  }
  .hdr__actions {
    display: flex;
    gap: var(--atc-space-2);
    align-items: center;
  }
  .hdr__subscribe {
    display: inline-flex;
    align-items: center;
    height: var(--atc-control-sm);
    padding-inline: var(--atc-space-4);
    border-radius: var(--adel-radius-pill);
    background: var(--adel-blue-500);
    color: var(--adel-white);
    font-size: var(--adel-text-sm);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .hdr__subscribe:hover { background: var(--adel-blue-400); color: var(--adel-white); }

  .hdr__lang {
    padding: 8px 12px;
    border-radius: var(--adel-radius-control);
    border: 1px solid var(--adel-nav-border);
    font-size: var(--adel-text-sm);
    font-weight: 500;
    color: var(--adel-nav-fg-strong);
    text-decoration: none;
    white-space: nowrap;
  }
  .hdr__lang:hover {
    border-color: var(--adel-nav-fg-hover);
    background: var(--adel-nav-bg-hover);
    color: var(--adel-nav-fg-hover);
  }

  /* ---- burger, hidden on desktop ---- */
  .hdr__burger {
    display: none;
    margin-inline-start: auto;
    width: 44px; /* 44×44 touch target regardless of visual height */
    height: 44px;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 5px;
    background: transparent;
    border: 1px solid var(--adel-nav-border);
    border-radius: var(--adel-radius-control);
    cursor: pointer;
  }
  .hdr__burger span {
    display: block;
    width: 18px;
    height: 2px;
    border-radius: 1px;
    background: var(--adel-nav-fg-strong);
  }
  /* The open menu is part of the bar, so it carries the bar's ground. A
     warm-white panel hanging off a graphite header reads as two components. */
  .hdr__mobile {
    display: none;
    flex-direction: column;
    gap: 2px;
    padding: var(--atc-space-4) var(--atc-space-5) var(--atc-space-5);
    border-top: 1px solid var(--adel-glass-edge);
    background: var(--adel-graphite);
  }
  .hdr__mobile .hdr__link {
    padding: 12px 14px;
  }
  .hdr__link--account,
  .hdr__link--lang {
    margin-top: var(--atc-space-2);
    border-top: 1px solid var(--adel-glass-edge);
    padding-top: var(--atc-space-4) !important;
    color: var(--adel-nav-fg-hover);
  }

  /* ---- compact lockup -----------------------------------------------------
     Below 480px the full lockup crowds the burger. The Design System's own
     compact form is the mark standing alone, so the WORDMARK is dropped and the
     mark is left at its published size — it stays at 28px, well clear of the
     measured 24px floor where the counter closes. The mark is not shrunk and no
     new compact artwork is invented. The link keeps its aria-label, so the
     accessible name is unchanged. */
  @media (max-width: 479px) {
    .hdr__logo :global(.atc-logo__word) {
      display: none;
    }
  }

  @media (max-width: 1023px) {
    .hdr__inner {
      padding: 0 var(--atc-space-5);
      gap: var(--atc-space-4);
    }
    .hdr__nav,
    .hdr__actions {
      display: none;
    }
    .hdr__burger {
      display: flex;
    }
    .hdr__mobile:not([hidden]) {
      display: flex;
    }
  }
</style>
