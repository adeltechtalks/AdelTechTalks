---
/* =============================================================================
   Site header — the one glass surface on the site (§17)
   =============================================================================
   §17: "Liquid Glass is an accent, not the entire website… The primary glass
   element should remain the approved navigation/chrome treatment."

   So this is it. Nothing else on any page uses backdrop-filter. If a second
   glass container appears anywhere, that is the budget being spent without a
   decision.

   The header actions stay SECONDARY: the header persists across every route,
   and a primary button here would compete with each page's own single primary
   action on every screen.
   ========================================================================== */

import Logo from './Logo.astro';
import AuthNav from './AuthNav.astro';
import Rich from './Rich.astro';
import PillarIcon from './PillarIcon.astro';
import { nav, site } from '../site.config';
import { useCopy } from '../copy';
import { navMenus } from '../lib/nav-menus';
import {
  DEFAULT_LANG,
  LANGS,
  LANG_TAG,
  isEnglishOnly,
  localizePath,
  neutralPath,
  type Lang,
} from '../i18n';

interface Props {
  lang?: Lang;
  /* Where the language switch should go, when the page knows better than the
     path does. A guide with an Arabic translation passes that translation's
     real URL, which is not the English slug with /ar in front of it. */
  switchTo?: string;
  /* The page exists in this language only. The switch then goes to the other
     language's home — a reader who taps it should land somewhere real. */
  switchToHome?: boolean;
}

const { lang = DEFAULT_LANG, switchTo, switchToHome = false } = Astro.props;
const c = useCopy(lang);

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const neutral = neutralPath(path) || '/';

/* Phase 1 only. Everything else in `nav` is defined but not rendered — the
   shape of the future navigation already exists, it is just not switched on. */
const items = nav
  .filter((item) => item.phase === 1)
  .map((item) => ({
    key: item.key,
    href: localizePath(item.path, lang),
    /* IA v2.0 labels come from the frozen `ia.nav` block, which is the
       authored copy from the designs of record — Learn is "اتعلم" in Arabic
       there, and Playground and the two pillar names stay English. Anything
       not in that block (the Phase 1.5 routes) keeps its Phase 1.1 label. */
    label:
      (c.ia.nav as Record<string, string>)[item.key] ??
      (c.nav as Record<string, string>)[item.key] ??
      item.key,
    active: neutral === item.path || neutral.startsWith(item.path + '/'),
    /* An Arabic page linking to an English-only route has to announce the
       language change on the anchor, or a screen reader reads English words in
       an Arabic voice. */
    foreign: lang !== DEFAULT_LANG && isEnglishOnly(item.path),
  }));

/* The three dropdowns, built once and rendered twice — desktop panel and
   mobile accordion are two presentations of one menu (lib/nav-menus.ts). A
   pillar with nothing published has no menu at all and stays a plain link. */
const menus = await navMenus(lang, c);
const menuFor = (key: string) => menus.find((m) => m.key === key);

/* An `aria-label` is a plain string, so the [[term]] markers Rich understands
   have to come off before the label reaches a screen reader. None of the three
   pillar names carries one today; this is the guard that keeps that true if one
   ever does. */
const plain = (text: string) => text.replace(/\[\[|\]\]/g, '');

const GLYPH = {
  vibeCoding: 'vibe-coding',
  gear: 'gear',
  learn: 'learn',
  playground: 'playground',
  about: 'about',
} as const;

const other = LANGS.find((l) => l !== lang)!;
/* Three cases, in order: the page told us where its counterpart is; the page
   told us it has none; or the path can be translated mechanically. The last one
   still has to handle an English-only route, which has no Arabic address at all
   — there the switch goes to that language's home rather than nowhere. */
const otherHref =
  switchTo ??
  (switchToHome || isEnglishOnly(neutral)
    ? localizePath('/', other)
    : localizePath(neutral, other));
const homeHref = localizePath('/', lang);
---

<header class="hdr">
  <div class="hdr__inner">
    {/* The approved AdelTechTalks lockup from the Design System — the locked
        mark geometry plus the wordmark, in the documented `reversed` role for a
        dark ground. Not a new logo and not a redraw: Logo.astro carries the
        exact path from atc-mark-currentcolor.svg.

        The accessible name is the CHANNEL, because that is what the lockup
        says. Brand architecture is unchanged — Adel remains the site's subject;
        AdelTechTalks is the recognisable identity that carries it. */}
    <a href={homeHref} class="hdr__logo" aria-label={`${site.showName} — ${c.common.home}`}>
      <Logo size={28} tone="reversed" />
    </a>

    {/* ---- desktop navigation, with the three frozen dropdowns -------------
         A pillar that has a menu renders TWO controls, not one: the label is
         still an ordinary link to the hub, and a separate button opens the
         panel. Folding both jobs into one element would mean either a link
         that cannot be opened from the keyboard, or a hub that cannot be
         reached at all — the design of record has "the logo returns home" and
         the pillar names reaching their hubs, so the link has to stay a link.

         Hover-intent opens the panel on a pointer; the button opens it on
         click, Enter or Space; Escape closes it and returns focus. */}
    <nav class="hdr__nav" aria-label="Main">
      {items.map((item) => {
        const menu = menuFor(item.key);
        return menu ? (
          <div class="hdr__item" data-menu={item.key}>
            <a
              href={item.href}
              class:list={['hdr__link', item.active && 'hdr__link--active']}
              aria-current={item.active ? 'page' : undefined}
              hreflang={item.foreign ? LANG_TAG[DEFAULT_LANG] : undefined}
            >
              <Rich text={item.label} />
            </a>
            <button
              type="button"
              class="hdr__chev"
              aria-expanded="false"
              aria-controls={`menu-${item.key}`}
              aria-label={`${plain(item.label)} — ${c.common.menuOpen}`}
            >
              <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                <path d="M4 6.5L8 10.5L12 6.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>

            <div class="hdr__panel" id={`menu-${item.key}`} hidden>
              <span class="hdr__panelIcon">
                <PillarIcon name={GLYPH[item.key as keyof typeof GLYPH]} size={24} />
              </span>
              <ul class="hdr__panelList">
                {menu.entries.map((entry) => (
                  <li>
                    <a class="hdr__panelLink" href={entry.href}><Rich text={entry.label} /></a>
                  </li>
                ))}
              </ul>
              <a class="hdr__panelAll" href={menu.allHref}>
                <Rich text={menu.allLabel} />
                <span aria-hidden="true">{lang === 'ar' ? '←' : '→'}</span>
              </a>
            </div>
          </div>
        ) : (
          <a
            href={item.href}
            class:list={['hdr__link', item.active && 'hdr__link--active']}
            aria-current={item.active ? 'page' : undefined}
            hreflang={item.foreign ? LANG_TAG[DEFAULT_LANG] : undefined}
          >
            <Rich text={item.label} />
          </a>
        );
      })}
    </nav>

    <div class="hdr__actions">
      {/* IA v2.0: Subscribe is the one filled action in the chrome. It is a
          nav destination like the rest — it just carries the weight, because
          it is the only thing in the header asking for something. */}
      <a class="hdr__subscribe" href={localizePath('/newsletter', lang)}>
        <Rich text={c.ia.nav.subscribe} />
      </a>
      <AuthNav lang={lang} />
      {/* The language switch is a link to the same page, not a dropdown: one
          tap, no menu, and it works with JavaScript switched off. `lang` and
          `hreflang` on the anchor tell a screen reader the destination is in
          another language before it is announced in the wrong voice. */}
      <a class="hdr__lang" href={otherHref} lang={LANG_TAG[other]} hreflang={LANG_TAG[other]}>
        {c.common.languageSwitch}
      </a>
    </div>

    <button
      class="hdr__burger"
      aria-label={c.common.menuOpen}
      data-label-open={c.common.menuOpen}
      data-label-close={c.common.menuClose}
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <span></span><span></span><span></span>
    </button>
  </div>

  {/* ---- mobile: full-screen accordion, one pillar open at a time --------
       Same entries as the desktop panels, same order, from the same list. A
       pillar with a menu gets a row split into a link and a disclosure button;
       one without stays a single full-width link. */}
  <nav class="hdr__mobile" id="mobile-nav" aria-label="Main" hidden>
    {items.map((item) => {
      const menu = menuFor(item.key);
      return menu ? (
        <div class="hdr__mItem" data-m-menu={item.key}>
          <div class="hdr__mRow">
            <a
              href={item.href}
              class:list={['hdr__link', item.active && 'hdr__link--active']}
              hreflang={item.foreign ? LANG_TAG[DEFAULT_LANG] : undefined}
            >
              <Rich text={item.label} />
            </a>
            <button
              type="button"
              class="hdr__mChev"
              aria-expanded="false"
              aria-controls={`m-menu-${item.key}`}
              aria-label={`${plain(item.label)} — ${c.common.menuOpen}`}
            >
              <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                <path d="M4 6.5L8 10.5L12 6.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
          </div>
          <ul class="hdr__mList" id={`m-menu-${item.key}`} hidden>
            {menu.entries.map((entry) => (
              <li><a class="hdr__mLink" href={entry.href}><Rich text={entry.label} /></a></li>
            ))}
            <li><a class="hdr__mLink hdr__mLink--all" href={menu.allHref}><Rich text={menu.allLabel} /></a></li>
          </ul>
        </div>
      ) : (
        <a
          href={item.href}
          class:list={['hdr__link', item.active && 'hdr__link--active']}
          hreflang={item.foreign ? LANG_TAG[DEFAULT_LANG] : undefined}
        >
          <Rich text={item.label} />
        </a>
      );
    })}
    <a class="hdr__link hdr__link--subscribe" href={localizePath('/newsletter', lang)}>
      <Rich text={c.ia.nav.subscribe} />
    </a>
    <a href={localizePath('/login', lang)} class="hdr__link hdr__link--account" data-m-auth-out>
      {c.common.signIn}
    </a>
    <a href={localizePath('/profile', lang)} class="hdr__link hdr__link--account" data-m-auth-in hidden>
      {c.common.profile}
    </a>
    <a class="hdr__link hdr__link--lang" href={otherHref} lang={LANG_TAG[other]} hreflang={LANG_TAG[other]}>
      {c.common.languageSwitch}
    </a>
  </nav>
</header>

<script>
  const burger = document.querySelector<HTMLButtonElement>('.hdr__burger');
  const menu = document.querySelector<HTMLElement>('.hdr__mobile');

  /* Mirror the header's account state into the mobile menu. Same cheap
     localStorage read as AuthNav — no SDK, no network. */
  const authEl = document.querySelector<HTMLElement>('[data-auth]');
  const ref = authEl?.dataset.ref;
  if (ref) {
    try {
      const raw = localStorage.getItem(`sb-${ref}-auth-token`);
      const session = raw ? JSON.parse(raw) : null;
      if (session && (!session.expires_at || session.expires_at * 1000 > Date.now())) {
        document.querySelector<HTMLElement>('[data-m-auth-out]')?.setAttribute('hidden', '');
        document.querySelector<HTMLElement>('[data-m-auth-in]')?.removeAttribute('hidden');
      }
    } catch {}
  }

  /* The bar lifts off the page only once there is content under it. Passive
     listener, one class toggle, no layout read beyond scrollY. */
  const header = document.querySelector<HTMLElement>('.hdr');
  const setScrolled = () => header?.classList.toggle('hdr--scrolled', window.scrollY > 4);
  setScrolled();
  window.addEventListener('scroll', setScrolled, { passive: true });

  /* ---- desktop dropdowns ------------------------------------------------
     Hover-intent plus click, per the frozen interaction spec. The intent delay
     is what stops a panel flashing open as the pointer crosses the bar on its
     way somewhere else; the close delay is what lets the pointer travel the
     gap between the label and the panel without the panel vanishing. */
  const OPEN_DELAY = 120;
  const CLOSE_DELAY = 180;

  const items = Array.from(document.querySelectorAll<HTMLElement>('.hdr__item'));

  function closeAll(except?: HTMLElement) {
    for (const item of items) {
      if (item === except) continue;
      const button = item.querySelector<HTMLButtonElement>('.hdr__chev');
      const panel = item.querySelector<HTMLElement>('.hdr__panel');
      if (!button || !panel || panel.hidden) continue;
      panel.hidden = true;
      button.setAttribute('aria-expanded', 'false');
    }
  }

  for (const item of items) {
    const button = item.querySelector<HTMLButtonElement>('.hdr__chev');
    const panel = item.querySelector<HTMLElement>('.hdr__panel');
    if (!button || !panel) continue;

    let openTimer = 0;
    let closeTimer = 0;

    const open = () => {
      closeAll(item);
      panel.hidden = false;
      button.setAttribute('aria-expanded', 'true');
    };
    const close = () => {
      panel.hidden = true;
      button.setAttribute('aria-expanded', 'false');
    };

    button.addEventListener('click', () => {
      window.clearTimeout(openTimer);
      window.clearTimeout(closeTimer);
      panel.hidden ? open() : close();
    });

    /* Pointer only. A touch device fires no hover, and a keyboard user opens
       the panel with the button — neither should be racing a timer. */
    item.addEventListener('pointerenter', (event) => {
      if ((event as PointerEvent).pointerType !== 'mouse') return;
      window.clearTimeout(closeTimer);
      openTimer = window.setTimeout(open, OPEN_DELAY);
    });
    item.addEventListener('pointerleave', (event) => {
      if ((event as PointerEvent).pointerType !== 'mouse') return;
      window.clearTimeout(openTimer);
      closeTimer = window.setTimeout(close, CLOSE_DELAY);
    });

    /* Tabbing out of the whole item closes it. `focusout` fires before the new
       element takes focus, so the check is deferred by one frame. */
    item.addEventListener('focusout', () => {
      requestAnimationFrame(() => {
        if (!item.contains(document.activeElement)) close();
      });
    });
  }

  /* A click anywhere else closes whatever is open — the ordinary expectation
     of a menu, and the thing that makes it usable on a hybrid touch laptop. */
  document.addEventListener('click', (event) => {
    const target = event.target as Node | null;
    if (target && items.some((item) => item.contains(target))) return;
    closeAll();
  });

  /* ---- mobile accordion: one pillar open at a time ---------------------- */
  const mChevs = Array.from(document.querySelectorAll<HTMLButtonElement>('.hdr__mChev'));
  for (const chev of mChevs) {
    chev.addEventListener('click', () => {
      const id = chev.getAttribute('aria-controls');
      const list = id ? document.getElementById(id) : null;
      if (!list) return;
      const willOpen = list.hidden;
      for (const other of mChevs) {
        const otherId = other.getAttribute('aria-controls');
        const otherList = otherId ? document.getElementById(otherId) : null;
        if (!otherList) continue;
        otherList.hidden = true;
        other.setAttribute('aria-expanded', 'false');
      }
      list.hidden = !willOpen;
      chev.setAttribute('aria-expanded', String(willOpen));
    });
  }

  burger?.addEventListener('click', () => {
    const open = burger.getAttribute('aria-expanded') === 'true';
    burger.setAttribute('aria-expanded', String(!open));
    burger.setAttribute(
      'aria-label',
      (open ? burger.dataset.labelOpen : burger.dataset.labelClose) ?? ''
    );
    if (menu) menu.hidden = open;
  });

  /* Escape closes it and returns focus to the button — a menu you can open
     with the keyboard has to be closable with the keyboard. */
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;

    /* An open dropdown is the innermost thing Escape should close, and focus
       goes back to the control that opened it. */
    const openItem = items.find(
      (item) => item.querySelector<HTMLButtonElement>('.hdr__chev')?.getAttribute('aria-expanded') === 'true'
    );
    if (openItem) {
      const button = openItem.querySelector<HTMLButtonElement>('.hdr__chev');
      const panel = openItem.querySelector<HTMLElement>('.hdr__panel');
      if (panel) panel.hidden = true;
      button?.setAttribute('aria-expanded', 'false');
      button?.focus();
      return;
    }

    if (!burger || !menu || menu.hidden) return;
    menu.hidden = true;
    burger.setAttribute('aria-expanded', 'false');
    burger.setAttribute('aria-label', burger.dataset.labelOpen ?? '');
    burger.focus();
  });
</script>

<style>
  /* ---- the graphite bar --------------------------------------------------
     Graphite base, restrained blur, a one-pixel highlight along the top edge
     and a dark rule along the bottom. No gradient, no glow: the depth is the
     blur and the shadow, and the shadow only exists once the page has moved. */
  .hdr {
    position: sticky;
    top: 0;
    z-index: var(--atc-z-3);
    background: var(--adel-glass-fill);
    backdrop-filter: blur(var(--adel-glass-blur)) saturate(1.2);
    -webkit-backdrop-filter: blur(var(--adel-glass-blur)) saturate(1.2);
    border-top: 1px solid var(--adel-glass-border);
    border-bottom: 1px solid var(--adel-glass-edge);
    transition: box-shadow var(--atc-duration-fast) var(--atc-ease-move);
  }
  .hdr--scrolled {
    box-shadow: var(--adel-glass-shadow);
  }
  /* Where backdrop-filter is unavailable the fill must become fully opaque, or
     page text scrolls through the bar and nothing on it stays legible. */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .hdr {
      background: var(--adel-graphite);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hdr { transition: none; }
  }

  .hdr__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--atc-space-8);
    height: 68px;
    display: flex;
    align-items: center;
    gap: var(--atc-space-8);
  }
  .hdr__logo {
    display: flex;
    text-decoration: none;
  }
  .hdr__nav {
    display: flex;
    align-items: center;
    gap: 2px;
    margin-inline-start: auto;
  }

  /* ---- a pillar with a dropdown -----------------------------------------
     The wrapper is the hover target: label, chevron and the panel below are
     one region, so the pointer can travel between them without the panel
     closing under it. */
  .hdr__item { position: relative; display: flex; align-items: center; }
  .hdr__chev {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 32px;
    margin-inline-start: -8px;
    padding: 0;
    background: transparent;
    border: 0;
    border-radius: var(--adel-radius-control);
    color: var(--adel-nav-fg);
    cursor: pointer;
  }
  .hdr__chev svg { width: 14px; height: 14px; display: block; transition: transform var(--atc-duration-fast) var(--atc-ease-move); }
  .hdr__chev:hover { color: var(--adel-nav-fg-hover); }
  .hdr__chev[aria-expanded='true'] { color: var(--adel-nav-fg-strong); }
  .hdr__chev[aria-expanded='true'] svg { transform: rotate(180deg); }

  /* The panel. 8px rise + fade over 200ms, per the frozen motion map. It is a
     solid graphite surface rather than a second glass one — the header is the
     site's ONE glass element and the budget is already spent on it. */
  .hdr__panel {
    position: absolute;
    top: calc(100% + 10px);
    inset-inline-start: 0;
    z-index: var(--atc-z-3);
    min-width: 232px;
    padding: var(--atc-space-4);
    border-radius: var(--adel-radius-card);
    background: var(--adel-graphite);
    border: 1px solid var(--adel-glass-border);
    box-shadow: var(--adel-elevation-3);
    animation: hdr-drop var(--atc-duration-fast) var(--atc-ease-enter) both;
  }
  .hdr__panel[hidden] { display: none; }
  @keyframes hdr-drop {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hdr__panel { animation: none; }
    .hdr__chev svg { transition: none; }
  }
  .hdr__panelIcon { display: block; margin-bottom: var(--atc-space-3); color: var(--adel-blue-300); }
  .hdr__panelList { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .hdr__panelLink {
    display: block;
    padding: 8px 10px;
    border-radius: var(--adel-radius-control);
    font-size: var(--adel-text-sm);
    color: var(--adel-nav-fg);
    text-decoration: none;
    white-space: nowrap;
  }
  .hdr__panelLink:hover { background: var(--adel-nav-bg-hover); color: var(--adel-nav-fg-strong); }
  .hdr__panelAll {
    display: flex;
    align-items: center;
    gap: var(--atc-space-2);
    margin-top: var(--atc-space-3);
    padding: 10px;
    border-top: 1px solid var(--adel-glass-edge);
    font-size: var(--adel-text-sm);
    font-weight: 600;
    color: var(--adel-blue-300);
    text-decoration: none;
    white-space: nowrap;
  }
  .hdr__panelAll:hover { color: var(--adel-white); }
  .hdr__link {
    position: relative;
    padding: 8px 12px;
    border-radius: var(--adel-radius-control);
    text-decoration: none;
    font-size: var(--adel-text-sm);
    font-weight: 500;
    color: var(--adel-nav-fg);
    white-space: nowrap;
  }
  .hdr__link:hover {
    background: var(--adel-nav-bg-hover);
    color: var(--adel-nav-fg-hover);
  }
  /* The active item is carried by weight and a full-white label — both survive
     greyscale. The Signature Blue rule under it is a graphic accent at 3.37:1
     on Graphite, which clears the 3:1 floor for non-text UI and is never asked
     to do the work of a label. */
  .hdr__link--active {
    color: var(--adel-nav-fg-strong);
    font-weight: 600;
  }
  .hdr__link--active::after {
    content: '';
    position: absolute;
    inset-inline: 12px;
    bottom: 2px;
    height: 2px;
    border-radius: 2px;
    background: var(--adel-nav-indicator);
  }
  .hdr__actions {
    display: flex;
    gap: var(--atc-space-2);
    align-items: center;
  }
  .hdr__subscribe {
    display: inline-flex;
    align-items: center;
    height: var(--atc-control-sm);
    padding-inline: var(--atc-space-4);
    border-radius: var(--adel-radius-pill);
    background: var(--adel-blue-500);
    color: var(--adel-white);
    font-size: var(--adel-text-sm);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .hdr__subscribe:hover { background: var(--adel-blue-400); color: var(--adel-white); }

  .hdr__lang {
    padding: 8px 12px;
    border-radius: var(--adel-radius-control);
    border: 1px solid var(--adel-nav-border);
    font-size: var(--adel-text-sm);
    font-weight: 500;
    color: var(--adel-nav-fg-strong);
    text-decoration: none;
    white-space: nowrap;
  }
  .hdr__lang:hover {
    border-color: var(--adel-nav-fg-hover);
    background: var(--adel-nav-bg-hover);
    color: var(--adel-nav-fg-hover);
  }

  /* ---- burger, hidden on desktop ---- */
  .hdr__burger {
    display: none;
    margin-inline-start: auto;
    width: 44px; /* 44×44 touch target regardless of visual height */
    height: 44px;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 5px;
    background: transparent;
    border: 1px solid var(--adel-nav-border);
    border-radius: var(--adel-radius-control);
    cursor: pointer;
  }
  .hdr__burger span {
    display: block;
    width: 18px;
    height: 2px;
    border-radius: 1px;
    background: var(--adel-nav-fg-strong);
    transition:
      transform var(--atc-duration-fast) var(--atc-ease-move),
      opacity var(--atc-duration-fast) var(--atc-ease-move);
  }
  /* Open, the three bars become the ✕ the design of record draws. It is driven
     off `aria-expanded`, so the visual state and the announced state are the
     same fact and cannot disagree. */
