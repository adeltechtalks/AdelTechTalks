---
/* EntryList — the editorial index row.

   §16 "Follow the Fewer Cards principle." A list of writing does not need
   fourteen bordered boxes; it needs a rule between items, a clear date, and a
   title big enough to be the thing you click. This is that.

   Handles guides, articles and videos identically — see lib/content.ts. */

import { formatDate, type Lang } from '../../i18n';
import { useCopy } from '../../copy';
import { findTopic } from '../../lib/content';
import Rich from '../Rich.astro';
import Icon from '../Icon.astro';
import type { Entry } from '../../lib/content';

interface Props {
  entries: Entry[];
  lang: Lang;
  /* Show the kind label (Guide / Article / Video). Off on a page that is
     already only one kind. */
  showKind?: boolean;
  /* Heading level for each item's title. h3 by default, because the list
     normally sits under a section's h2. On an index page where the list
     follows the page h1 directly, pass 2 — skipping a level breaks the
     document outline for screen-reader navigation (§30). */
  headingLevel?: 2 | 3 | 4;
  class?: string;
}

/* `...rest` forwards the scope attribute Astro hands a child component, so a
   parent styling this component through `class` actually reaches it. See the
   long note in src/components/Rich.astro. */
const { entries, lang, showKind = true, headingLevel = 3, class: className, ...rest } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3' | 'h4';
const c = useCopy(lang);
---

<ul class:list={['el', className]} {...rest}>
  {entries.map((entry) => {
    const topic = findTopic(entry.topic);
    return (
      <li class="el__item">
        <a
          class="el__link"
          href={entry.href}
          rel={entry.external ? 'noopener' : undefined}
          target={entry.external ? '_blank' : undefined}
        >
          <div class="el__meta">
            <time class="el__date nums" datetime={entry.date.toISOString().slice(0, 10)}>
              {entry.date.valueOf() > 0 ? formatDate(entry.date, lang) : ''}
            </time>
            {showKind && <span class="el__kind">{c.latest.kind[entry.kind]}</span>}
            {topic && <Rich text={topic[lang].name} class="el__topic" />}
          </div>

          <Heading class="el__title">{entry.title}</Heading>
          {entry.description && <p class="el__desc">{entry.description}</p>}

          <span class="el__tail">
            {entry.minutes && <span class="el__mins nums">{c.common.minutes(entry.minutes)}</span>}
            {entry.external && (
              <span class="el__ext" aria-hidden="true"><Icon name="external-link" size="sm" /></span>
            )}
          </span>
        </a>
      </li>
    );
  })}
</ul>

<style>
  .el {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--adel-border-hairline);
  }
  .el__item {
    border-bottom: 1px solid var(--adel-border-hairline);
  }
  .el__link {
    display: block;
    padding: var(--atc-space-6) 0;
    text-decoration: none;
    color: inherit;
    position: relative;
  }
  .el__link:hover .el__title {
    color: var(--adel-text-link);
  }

  .el__meta {
    display: flex;
    align-items: center;
    gap: var(--atc-space-3);
    flex-wrap: wrap;
    font-size: var(--adel-text-xs);
    color: var(--adel-text-tertiary);
    margin-bottom: var(--atc-space-2);
  }
  .el__date {
    font-family: var(--adel-font-mono);
  }
  .el__kind {
    font-weight: 600;
    letter-spacing: var(--adel-tracking-wide);
    text-transform: uppercase;
    color: var(--adel-signature-blue);
  }
  :global([lang='ar']) .el__kind {
    text-transform: none;
    letter-spacing: normal;
  }
  .el__topic {
    color: var(--adel-text-secondary);
  }
  .el__topic::before {
    content: '·';
    margin-inline-end: var(--atc-space-3);
  }

  .el__title {
    margin: 0 0 var(--atc-space-2);
    font-family: var(--adel-font-display-sm);
    font-size: clamp(19px, 2.2vw, 23px);
    line-height: 1.3;
    font-weight: 600;
    letter-spacing: var(--adel-tracking-tight);
    color: var(--adel-text-primary);
    max-width: 34ch;
  }
  :global([lang='ar']) .el__title {
    letter-spacing: normal;
    line-height: 1.5;
  }
  .el__desc {
    margin: 0;
    font-size: var(--adel-text-sm);
    line-height: 1.6;
    color: var(--adel-text-secondary);
    max-width: 62ch;
  }

  .el__tail {
    position: absolute;
    inset-block-start: var(--atc-space-6);
    inset-inline-end: 0;
    display: flex;
    align-items: center;
    gap: var(--atc-space-2);
    font-size: var(--adel-text-xs);
    color: var(--adel-text-tertiary);
  }
  .el__mins {
    font-family: var(--adel-font-mono);
  }

  @media (max-width: 767px) {
    .el__tail {
      position: static;
      margin-top: var(--atc-space-3);
    }
  }
</style>
