---
/* =============================================================================
   PhotoFigure — the photography primitive (§15)
   =============================================================================
   Handles the aspect ratio, the crop, the caption and the responsive
   behaviour. Everything photographic on the site goes through it.

   ── NO PHOTOGRAPH MEANS NO FIGURE ───────────────────────────────────────────
   §15 still holds and is not negotiable: a missing photograph is never filled
   with stock or generated imagery, and never with a fake image of Adel.

   What changed is what happens instead. This used to render a designed slot —
   a dashed frame around a picture glyph — on the theory that it looked
   deliberate. It does not. A dashed border around a picture icon is the
   universal browser idiom for "this image failed to load", so on a live page it
   reads as broken rather than as reserved, and it was doing that on the About
   page and the homepage sign-off.

   So with no `src` this component renders NOTHING, and the layouts that use it
   collapse to their single-column form. The moment a real photograph is added
   to `photography` in site.config.ts, the figure and its column come back with
   no other change — the same content-availability pattern the empty Guides and
   Videos surfaces already follow.
   ========================================================================== */

interface Props {
  src?: string;
  /* Optional narrower crop used below 768px. Falls back to `src`. */
  srcMobile?: string;
  alt?: string;
  caption?: string;
  /* Aspect ratio as a CSS ratio: '3 / 4', '3 / 2', '16 / 9', '1 / 1'. */
  ratio?: string;
  ratioMobile?: string;
  /* What belongs here — an AUTHORING NOTE, never rendered.

     Documentation at the call site, for whoever adds the photograph. It is
     deliberately not printed into the page: a visitor should never be told
     "A portrait of Adel goes here", any more than they should be told to edit
     a config file. */
  slotNote?: string;
  /* Above the fold? Then it is not lazy and it gets fetch priority. */
  priority?: boolean;
  rounded?: boolean;
  class?: string;
}

const {
  src,
  srcMobile,
  alt = '',
  caption,
  ratio = '3 / 4',
  ratioMobile,
  slotNote,
  priority = false,
  rounded = true,
  class: className,
} = Astro.props;

const hasPhoto = Boolean(src);
const mobile = srcMobile || src;
---

{hasPhoto && (
<figure class:list={['pf', rounded && 'pf--rounded', className]}>
  <div
    class="pf__frame"
    style={`--pf-ratio:${ratio};--pf-ratio-mobile:${ratioMobile || ratio}`}
  >
    <picture>
      {srcMobile && <source media="(max-width: 767px)" srcset={mobile} />}
      <img
        class="pf__img"
        src={src}
        alt={alt}
        loading={priority ? 'eager' : 'lazy'}
        decoding={priority ? 'sync' : 'async'}
        fetchpriority={priority ? 'high' : 'auto'}
      />
    </picture>
  </div>

  {caption && <figcaption class="pf__caption">{caption}</figcaption>}
</figure>
)}

<style>
  .pf {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--atc-space-3);
  }
  .pf__frame {
    position: relative;
    aspect-ratio: var(--pf-ratio);
    overflow: hidden;
    background: var(--adel-surface-sunken);
  }
  .pf--rounded .pf__frame {
    border-radius: var(--adel-radius-media);
  }
  .pf__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* The safe area: a portrait's face sits in the upper third, so a crop
       takes it off the bottom, never off the top. */
    object-position: center 30%;
  }

  .pf__caption {
    font-size: var(--adel-text-sm);
    line-height: 1.55;
    color: var(--adel-text-secondary);
    max-width: 52ch;
  }

  @media (max-width: 767px) {
    .pf__frame {
      aspect-ratio: var(--pf-ratio-mobile);
    }
  }
</style>
