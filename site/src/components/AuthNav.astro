---
/* The header's account control.
 *
 * Deliberately does NOT import supabase-js. That bundle is ~217KB and this only
 * needs to answer one question: is someone signed in? Supabase stores its
 * session in localStorage under `sb-<project-ref>-auth-token`, so a few lines
 * read it directly. The SDK still loads on pages that actually talk to the
 * database — this just decides which control to show.
 *
 * Renders signed-out by default so the markup is correct for crawlers and for
 * anyone with JavaScript off.
 */
import { services } from '../site.config';
import { useCopy } from '../copy';
import { DEFAULT_LANG, localizePath, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
}

const { lang = DEFAULT_LANG } = Astro.props;
const c = useCopy(lang);

const ref = services.supabaseUrl
  ? new URL(services.supabaseUrl).hostname.split('.')[0]
  : '';
const live = Boolean(services.supabaseUrl && services.supabaseAnonKey);
---

{live && (
  <div class="auth" data-auth data-ref={ref}>
    <a class="auth__signin" href={localizePath('/login', lang)} data-auth-out>{c.common.signIn}</a>
    <a class="auth__profile" href={localizePath('/profile', lang)} data-auth-in hidden>
      <span class="auth__avatar" data-auth-initial>A</span>
      <span class="auth__label">{c.common.profile}</span>
    </a>
  </div>
)}

<script>
  const el = document.querySelector<HTMLElement>('[data-auth]');
  const ref = el?.dataset.ref;
  if (el && ref) {
    try {
      const raw = localStorage.getItem(`sb-${ref}-auth-token`);
      if (raw) {
        const session = JSON.parse(raw);
        // Treat an expired token as signed out rather than showing a stale name.
        const stillValid = !session.expires_at || session.expires_at * 1000 > Date.now();
        if (stillValid) {
          const name =
            session.user?.user_metadata?.full_name || session.user?.email || 'You';
          const out = el.querySelector<HTMLElement>('[data-auth-out]');
          const inEl = el.querySelector<HTMLElement>('[data-auth-in]');
          const initial = el.querySelector<HTMLElement>('[data-auth-initial]');
          if (initial) initial.textContent = (name[0] || 'A').toUpperCase();
          if (out) out.hidden = true;
          if (inEl) inEl.hidden = false;
        }
      }
    } catch {
      /* malformed or unavailable storage — stay signed out, which is safe */
    }
  }
</script>

<style>
  .auth { display: flex; align-items: center; }
  .auth__signin {
    display: inline-flex;
    align-items: center;
    height: var(--atc-control-md);
    padding: 0 var(--atc-space-4);
    border-radius: var(--adel-radius-control);
    font-size: var(--adel-text-sm);
    font-weight: 500;
    color: var(--adel-nav-fg);
    text-decoration: none;
    white-space: nowrap;
  }
  .auth__signin:hover { background: var(--adel-nav-bg-hover); color: var(--adel-nav-fg-hover); }

  .auth__profile {
    display: inline-flex;
    align-items: center;
    gap: var(--atc-space-2);
    height: var(--atc-control-md);
    /* logical, so the avatar keeps its tight edge in RTL too */
    padding-block: 0;
    padding-inline: 4px var(--atc-space-3);
    border-radius: var(--adel-radius-pill);
    border: 1px solid var(--adel-nav-border);
    background: transparent;
    text-decoration: none;
    color: var(--adel-nav-fg);
  }
  .auth__profile:hover { border-color: var(--adel-nav-fg-hover); color: var(--adel-nav-fg-hover); }
  .auth__avatar {
    width: 28px;
    height: 28px;
    flex: 0 0 auto;
    border-radius: var(--adel-radius-circle);
    background: var(--adel-signature-blue);
    color: var(--adel-white);
    display: grid;
    place-items: center;
    font-size: 12px;
    font-weight: 600;
  }
  .auth__label { font-size: var(--adel-text-sm); font-weight: 500; }
</style>
