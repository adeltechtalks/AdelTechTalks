---
/* The editorial story row — 180px 3:2 thumb / 1fr / auto.

   Shared by the Gear Hub and the Vibe Coding Hub. The reuse map calls for
   "same code", so both pillars import this rather than each growing their own
   near-identical row.

   The headline is always the QUESTION. The thumbnail is optional and collapses
   to nothing when a story has no image — a row with a grey rectangle where a
   photograph should be reads as broken, and there is no substitute image to
   put there.

   A paused build is `dimmed`, never hidden: a build that disappears when it
   stalls is a rewritten history. */

import Rich from '../Rich.astro';
import StatusPill from './StatusPill.astro';
import type { Lang } from '../../i18n';

interface Props {
  lang: Lang;
  href: string;
  question: string;
  context?: string;
  label: string;
  tone?: 'mint' | 'blue' | 'ghost' | 'neutral';
  thumb?: string;
  thumbAlt?: string;
  cta: string;
  dimmed?: boolean;
  /** Stagger index within its group. */
  step?: number;
}

const {
  lang, href, question, context, label, tone = 'ghost',
  thumb, thumbAlt = '', cta, dimmed = false, step = 0,
} = Astro.props;

const arrow = lang === 'ar' ? '←' : '→';
---

<li class:list={['sr', dimmed && 'sr--dimmed']} data-vb-stage style={`--vb-step:${step}`}>
  <a class="sr__link" href={href}>
    {thumb && (
      <span class="sr__thumb">
        <img src={thumb} alt={thumbAlt} loading="lazy" decoding="async" />
      </span>
    )}

    <span class="sr__body">
      <StatusPill label={label} tone={tone} />
      <Rich text={question} as="span" class="sr__q" />
      {context && <Rich text={context} as="span" class="sr__context" />}
    </span>

    <span class="sr__cta">
      <Rich text={cta} />
      <span class="sr__arrow" aria-hidden="true">{arrow}</span>
    </span>
  </a>
</li>

<style>
  .sr { border-top: 1px solid var(--adel-border-hairline); }
  .sr--dimmed { opacity: 0.62; }

  .sr__link {
    display: grid;
    grid-template-columns: 180px 1fr auto;
    align-items: center;
    gap: var(--atc-space-6);
    /* ≥44px target, per the row-is-the-link rule. */
    padding-block: var(--atc-space-6);
    text-decoration: none;
    color: inherit;
  }
  /* A row with no photograph simply has no thumb column. */
  .sr__link:not(:has(.sr__thumb)) { grid-template-columns: 1fr auto; }

  .sr__thumb {
    display: block;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: var(--adel-radius-media);
    background: var(--adel-surface-sunken);
  }
  .sr__thumb img { display: block; width: 100%; height: 100%; object-fit: cover; }

  .sr__body { display: flex; flex-direction: column; align-items: flex-start; gap: var(--atc-space-2); }
  .sr__q {
    font-family: var(--adel-font-display);
    font-size: clamp(19px, 2.2vw, 24px);
    line-height: 1.3;
    font-weight: 700;
    letter-spacing: var(--adel-tracking-tight);
    color: var(--adel-text-primary);
  }
  /* Below Ghorab's 24px floor at the small end, so Arabic rows are Readex at
     the design's own weight — TY v2.0, and what the Learn spec calls correct. */
  :global([lang='ar']) .sr__q {
    font-family: var(--adel-font-text);
    font-size: 18px;
    letter-spacing: normal;
    line-height: 1.6;
    unicode-bidi: plaintext;
  }
  .sr__link:hover .sr__q { color: var(--adel-text-link); }

  .sr__context {
    font-size: var(--adel-text-sm);
    line-height: 1.6;
    color: var(--adel-text-secondary);
    max-width: 62ch;
  }
  :global([lang='ar']) .sr__context { font-size: 14px; line-height: 1.85; unicode-bidi: plaintext; }

  .sr__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--atc-space-2);
    font-size: var(--adel-text-sm);
    font-weight: 600;
    color: var(--adel-text-link);
    white-space: nowrap;
  }
  .sr__arrow { display: inline-block; }
  @media (prefers-reduced-motion: no-preference) {
    .sr__arrow { transition: transform var(--atc-duration-fast) var(--atc-ease-move); }
    .sr__link:hover .sr__arrow { transform: translateX(var(--atc-distance-1)); }
    :global([dir='rtl']) .sr__link:hover .sr__arrow { transform: translateX(calc(-1 * var(--atc-distance-1))); }
  }

  @media (max-width: 767px) {
    .sr__link { grid-template-columns: 110px 1fr; gap: var(--atc-space-4); }
    .sr__link:not(:has(.sr__thumb)) { grid-template-columns: 1fr; }
    .sr__cta { grid-column: 1 / -1; }
  }
</style>
