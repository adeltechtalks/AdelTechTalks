---
import EntryPage from '../../../components/pages/EntryPage.astro';
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const guides = await getCollection('guides', ({ data }) => !data.draft && data.lang === 'ar');
  return guides.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
};

const { entry } = Astro.props;
const { Content } = await render(entry);
---
<EntryPage lang="ar" kind="guide" slug={entry.id} data={entry.data}>
  <Content />
</EntryPage>
