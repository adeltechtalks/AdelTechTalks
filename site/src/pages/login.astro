---
/* Sign in / create an account.
 *
 * With Google there is no separate signup step — the first sign-in creates the
 * account. The page says so plainly rather than showing two buttons that do the
 * same thing.
 *
 * ?next=/some/path sends people back where they came from afterwards.
 */
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import Icon from '../components/Icon.astro';
import { services, site } from '../site.config';

const live = Boolean(services.supabaseUrl && services.supabaseAnonKey);
---

<Base title="Sign in" description={`Sign in to ${site.name} to keep your badges and your Tech Passport.`}>
  <section class="container lg">
    <div class="lg__intro">
      <span class="overline">Account</span>
      <h1 class="h-display">Sign in</h1>
      <p class="lede">
        Your badges, your Tech Passport, and the links you can post — all kept against your
        account so they follow you between devices.
      </p>
    </div>

    <Card elevation={3} padding="var(--atc-space-8)" class="lg__card">
      {live ? (
        <div class="lg__body">
          <button class="lg__google" type="button" data-google>
            <svg class="lg__g" viewBox="0 0 18 18" width="20" height="20" aria-hidden="true">
              <path fill="#4285F4" d="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84a4.14 4.14 0 0 1-1.8 2.72v2.26h2.92c1.7-1.57 2.68-3.88 2.68-6.62Z"/>
              <path fill="#34A853" d="M9 18c2.43 0 4.47-.8 5.96-2.18l-2.92-2.26c-.8.54-1.84.86-3.04.86-2.34 0-4.32-1.58-5.03-3.7H.96v2.33A9 9 0 0 0 9 18Z"/>
              <path fill="#FBBC05" d="M3.97 10.72a5.4 5.4 0 0 1 0-3.44V4.95H.96a9 9 0 0 0 0 8.1l3.01-2.33Z"/>
              <path fill="#EA4335" d="M9 3.58c1.32 0 2.5.45 3.44 1.35l2.58-2.58C13.46.89 11.43 0 9 0A9 9 0 0 0 .96 4.95l3.01 2.33C4.68 5.16 6.66 3.58 9 3.58Z"/>
            </svg>
            <span data-google-label>Continue with Google</span>
          </button>

          <p class="lg__note muted" data-status>
            No separate signup — the first time you continue with Google, your account is created.
          </p>

          <ul class="lg__what">
            <li><Icon name="award" size="sm" /> Keep every badge you earn</li>
            <li><Icon name="link" size="sm" /> Get a link for each one you can post</li>
            <li><Icon name="smartphone" size="sm" /> Same passport on your phone and laptop</li>
          </ul>

          <p class="lg__legal muted">
            We only ever receive your name and email address from Google, and only use them to
            show your badges. Nothing is posted on your behalf.
          </p>
        </div>
      ) : (
        <div class="lg__body">
          <strong class="h-card">Accounts are not switched on yet</strong>
          <p class="muted">Supabase needs connecting first — step 7 in LAUNCH.md.</p>
        </div>
      )}
    </Card>

    <p class="lg__back">
      <a href="/playground/">← Back to the games</a>
    </p>
  </section>
</Base>

<div
  id="pg-data"
  hidden
  data-supabase-url={services.supabaseUrl}
  data-supabase-key={services.supabaseAnonKey}
></div>

<script>
  const el = document.getElementById('pg-data');
  const url = el?.dataset.supabaseUrl;
  const key = el?.dataset.supabaseKey;
  const btn = document.querySelector<HTMLButtonElement>('[data-google]');
  const status = document.querySelector<HTMLElement>('[data-status]');
  const label = document.querySelector<HTMLElement>('[data-google-label]');

  /* Only send people to paths on this site — never to an address supplied in
     the query string, which would make this an open redirect. */
  const params = new URLSearchParams(location.search);
  const raw = params.get('next') ?? '/profile/';
  const next = raw.startsWith('/') && !raw.startsWith('//') ? raw : '/profile/';

  if (el && url && key && btn) {
    const pg = await import('../lib/playground');
    const sb = pg.getClient(url, key);

    // Already signed in? Do not make them click a button that does nothing.
    const existing = await pg.currentUser(sb);
    if (existing) {
      location.replace(next);
    } else {
      btn.addEventListener('click', async () => {
        btn.disabled = true;
        if (label) label.textContent = 'Opening Google…';
        try {
          await sb.auth.signInWithOAuth({
            provider: 'google',
            options: { redirectTo: new URL(next, location.origin).href },
          });
        } catch (e: any) {
          btn.disabled = false;
          if (label) label.textContent = 'Continue with Google';
          if (status) status.textContent = `Could not start sign-in: ${e.message}`;
        }
      });
    }
  }
</script>

<style>
  .lg { max-width: 520px; }
  .lg__intro {
    display: flex;
    flex-direction: column;
    gap: var(--atc-space-4);
    margin-bottom: var(--atc-space-6); /* was --atc-space-7, which does not exist on the 4px scale — the rule was being dropped and the gap collapsed to 0 */
  }
  .lg__card { align-items: stretch; }
  .lg__body { display: flex; flex-direction: column; gap: var(--atc-space-5); }

  /* Google's mark is a third-party asset: used as supplied, never restyled to
     our stroke and never recoloured to brand purple. */
  .lg__google {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--atc-space-3);
    width: 100%;
    height: var(--atc-control-lg);
    box-sizing: border-box;
    font-family: var(--atc-font-text);
    font-size: var(--atc-body-base-size);
    font-weight: var(--atc-label-weight);
    color: var(--atc-ink-900);
    background: var(--atc-white);
    border: var(--atc-stroke-strong) solid var(--atc-ink-200);
    border-radius: var(--atc-radius-control);
    cursor: pointer;
    transition: background-color var(--atc-duration-micro) var(--atc-ease-move),
                border-color var(--atc-duration-micro) var(--atc-ease-move);
  }
  .lg__google:hover:not(:disabled) {
    background: var(--atc-purple-50);
    border-color: var(--atc-purple-600);
  }
  .lg__google:active:not(:disabled) { transform: translateY(var(--atc-pressed-translate-block)); }
  .lg__google:disabled { cursor: not-allowed; color: var(--atc-ink-300); }
  .lg__g { flex: 0 0 auto; }

  .lg__note { font-size: var(--atc-body-small-size); margin: 0; text-align: center; }

  .lg__what {
    list-style: none;
    margin: 0;
    padding: var(--atc-space-5) 0 0;
    border-top: var(--atc-stroke-hairline) solid var(--atc-ink-100);
    display: flex;
    flex-direction: column;
    gap: var(--atc-space-3);
  }
  .lg__what li {
    display: flex;
    align-items: center;
    gap: var(--atc-space-3);
    font-size: var(--atc-body-small-size);
    color: var(--atc-ink-700);
  }

  .lg__legal { margin: 0; font-size: 12px; line-height: 18px; }

  .lg__back { margin-top: var(--atc-space-6); font-size: var(--atc-body-small-size); }
  .lg__back a { color: var(--atc-purple-700); text-decoration: none; }
  .lg__back a:hover { text-decoration: underline; }

  @media (prefers-reduced-motion: reduce) {
    .lg__google { transition: none; }
    .lg__google:active:not(:disabled) { transform: none; }
  }
</style>
