---
/* =============================================================================
   The temporary holding page
   =============================================================================
   Deliberately standalone: it does NOT use Base.astro, app.css or any shared
   component. A holding page that imports the site's layout inherits the site's
   nav, footer, font loading and 40 KB of CSS — none of which it wants — and
   becomes something that can break when the real site is worked on. Everything
   it needs is in this one file.

   It lives at /coming-soon during development so it can be previewed with
   `npm run dev`. In a maintenance build `scripts/maintenance.mjs` promotes it to
   dist/index.html and deletes dist/coming-soon/, so the only URL that ever
   serves it in production is `/`.

   The social URLs are read from src/site.config.ts — the same single source of
   truth the real site uses. None are written here, so none can drift.
   ========================================================================== */
import { site } from '../site.config';

/* Read as an open record so asking for a network that is not configured is a
   plain `undefined` rather than a type error. That is what lets the list below
   name every preferred network while shipping only the ones that exist. */
const social = site.social as Record<string, string | undefined>;

/* Only networks with a real URL in site.config.ts get a link. A network with no
   configured profile is simply absent — never a placeholder, never a guess. */
const NETWORKS = [
  {
    key: 'tiktok',
    label: 'TikTok',
    /* Simple Icons, CC0 */
    path: 'M12.53.02C13.84 0 15.14.01 16.44 0c.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.03 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z',
    url: social.tiktok,
  },
  {
    key: 'instagram',
    label: 'Instagram',
    path: 'M12 0C8.74 0 8.333.015 7.053.072 5.775.132 4.905.333 4.14.63c-.789.306-1.459.717-2.126 1.384S.935 3.35.63 4.14C.333 4.905.131 5.775.072 7.053.012 8.333 0 8.74 0 12s.015 3.667.072 4.947c.06 1.277.261 2.148.558 2.913.306.788.717 1.459 1.384 2.126.667.666 1.336 1.079 2.126 1.384.766.296 1.636.499 2.913.558C8.333 23.988 8.74 24 12 24s3.667-.015 4.947-.072c1.277-.06 2.148-.262 2.913-.558.788-.306 1.459-.718 2.126-1.384.666-.667 1.079-1.335 1.384-2.126.296-.765.499-1.636.558-2.913.06-1.28.072-1.687.072-4.947s-.015-3.667-.072-4.947c-.06-1.277-.262-2.149-.558-2.913-.306-.789-.718-1.459-1.384-2.126C21.319 1.347 20.651.935 19.86.63c-.765-.297-1.636-.499-2.913-.558C15.667.012 15.26 0 12 0zm0 2.16c3.203 0 3.585.016 4.85.071 1.17.055 1.805.249 2.227.415.562.217.96.477 1.382.896.419.42.679.819.896 1.381.164.422.36 1.057.413 2.227.057 1.266.07 1.646.07 4.85s-.015 3.585-.074 4.85c-.061 1.17-.256 1.805-.421 2.227-.224.562-.479.96-.899 1.382-.419.419-.824.679-1.38.896-.42.164-1.065.36-2.235.413-1.274.057-1.649.07-4.859.07-3.211 0-3.586-.015-4.859-.074-1.171-.061-1.816-.256-2.236-.421-.569-.224-.96-.479-1.379-.899-.421-.419-.69-.824-.9-1.38-.165-.42-.359-1.065-.42-2.235-.045-1.26-.061-1.649-.061-4.844 0-3.196.016-3.586.061-4.861.061-1.17.255-1.814.42-2.234.21-.57.479-.96.9-1.381.419-.419.81-.689 1.379-.898.42-.166 1.051-.361 2.221-.421 1.275-.045 1.65-.06 4.859-.06l.045.03zm0 3.678a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm7.846-10.405a1.441 1.441 0 01-2.88 0 1.44 1.44 0 012.88 0z',
    url: social.instagram,
  },
  {
    key: 'youtube',
    label: 'YouTube',
    path: 'M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z',
    url: social.youtube,
  },
  {
    key: 'facebook',
    label: 'Facebook',
    path: 'M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z',
    url: social.facebook,
  },
  {
    key: 'linkedin',
    label: 'LinkedIn',
    path: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
    url: social.linkedin,
  },
].filter((n): n is typeof n & { url: string } => typeof n.url === 'string' && n.url.length > 0);

const MARK = 'M 139.96 0.1 L 98.09 0 L 0 179.9 L 40.87 180 L 118.57 37.49 L 161.89 121.04 L 101.29 120.89 L 69.49 179.21 L 108.07 179.31 L 121.08 155.45 L 220.64 155.69 Z';
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.showName} — Coming Soon</title>
    <meta name="description" content="Learn it. Test it. Build it." />

    <!-- Self-referencing, and pointing at `/` rather than at this file's build
         path, because `/` is the only URL that ever serves this page. -->
    <link rel="canonical" href={new URL('/', site.url).href} />

    <!-- Temporary page: it must not be indexed, and no link on it followed. -->
    <meta name="robots" content="noindex, nofollow" />
    <meta name="googlebot" content="noindex, nofollow" />

    <link rel="icon" type="image/png" sizes="32x32" href="/logo/favicon-32.png" />
    <link rel="apple-touch-icon" href="/logo/apple-touch-icon.png" />
    <meta name="theme-color" content="#FAFAF8" />

    <!-- One font, two weights, self-hostless. `display=swap` means text paints
         immediately in the fallback and never blocks first render. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;800&display=swap"
    />

    <style is:inline>
      /* Brand tokens, copied rather than imported — see the note in the
         frontmatter. Values are the canonical ones from
         src/styles/tokens/adel-v2.css. */
      :root {
        --canvas: #fafaf8;   /* Warm White — the page canvas, not pure white */
        --ink: #171a1f;      /* Graphite — primary text */
        --slate: #667085;    /* Secondary text */
        --blue: #2563eb;     /* Signature Blue — accent only */
        --hair: #e6e8ec;     /* Hairlines */
      }

      *,
      *::before,
      *::after { box-sizing: border-box; }

      html { -webkit-text-size-adjust: 100%; }

      body {
        margin: 0;
        min-height: 100svh;
        display: grid;
        place-items: center;
        padding: clamp(24px, 6vw, 64px);
        background: var(--canvas);
        color: var(--ink);
        font-family: 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        font-weight: 500;
        text-align: center;
        /* Never a horizontal scrollbar, at any width. */
        overflow-x: hidden;
      }

      main {
        display: flex;
        flex-direction: column;
        align-items: center;
        /* The whitespace rhythm: generous, and proportional to the viewport. */
        gap: clamp(20px, 4vw, 32px);
        max-width: 34rem;
      }

      .mark {
        width: clamp(38px, 8vw, 52px);
        height: auto;
        color: var(--blue);
        display: block;
      }

      .wordmark {
        margin: 0;
        font-size: clamp(1.75rem, 7vw, 3rem);
        font-weight: 800;
        letter-spacing: -0.02em;
        line-height: 1.05;
        /* Keeps the Latin wordmark rendering LTR regardless of context. */
        direction: ltr;
        unicode-bidi: isolate;
      }

      .status {
        margin: 0;
        font-size: clamp(0.688rem, 2.2vw, 0.813rem);
        font-weight: 800;
        letter-spacing: 0.24em;
        text-transform: uppercase;
        color: var(--blue);
      }

      .tagline {
        margin: 0;
        font-size: clamp(0.938rem, 3.4vw, 1.125rem);
        font-weight: 500;
        line-height: 1.6;
        color: var(--slate);
      }

      .rule {
        width: clamp(40px, 12vw, 64px);
        height: 1px;
        border: 0;
        margin: 0;
        background: var(--hair);
      }

      .socials {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: clamp(14px, 4vw, 20px);
      }

      .socials a {
        display: grid;
        place-items: center;
        /* 44px — the minimum comfortable touch target. */
        width: 44px;
        height: 44px;
        border-radius: 50%;
        color: var(--slate);
        transition: color 160ms ease, background-color 160ms ease;
      }

      .socials svg {
        width: 21px;
        height: 21px;
        display: block;
      }

      .socials a:hover,
      .socials a:focus-visible {
        color: var(--blue);
        background: #fff;
      }

      .socials a:focus-visible {
        outline: 2px solid var(--blue);
        outline-offset: 2px;
      }

      .contact {
        margin: 0;
        font-size: clamp(0.813rem, 2.6vw, 0.875rem);
        font-weight: 500;
        color: var(--slate);
      }

      .contact a {
        color: var(--ink);
        text-decoration: none;
        border-bottom: 1px solid var(--hair);
        padding-bottom: 1px;
        /* An email address must never be broken across lines mid-word on a
           narrow screen, but it must still wrap rather than overflow. */
        overflow-wrap: anywhere;
        transition: color 160ms ease, border-color 160ms ease;
      }

      .contact a:hover,
      .contact a:focus-visible {
        color: var(--blue);
        border-color: var(--blue);
      }

      .contact a:focus-visible {
        outline: 2px solid var(--blue);
        outline-offset: 3px;
      }

      /* The one permitted animation: a single, subtle entrance. No loops, no
         background effects, nothing that keeps the compositor busy after
         paint. */
      @media (prefers-reduced-motion: no-preference) {
        main > * {
          animation: rise 520ms cubic-bezier(0.22, 0.61, 0.36, 1) both;
        }
        main > :nth-child(2) { animation-delay: 60ms; }
        main > :nth-child(3) { animation-delay: 100ms; }
        main > :nth-child(4) { animation-delay: 140ms; }
        main > :nth-child(5) { animation-delay: 180ms; }
        main > :nth-child(6) { animation-delay: 220ms; }
        main > :nth-child(7) { animation-delay: 260ms; }
      }

      @keyframes rise {
        from { opacity: 0; transform: translateY(8px); }
        to   { opacity: 1; transform: none; }
      }
    </style>
  </head>

  <body>
    <main>
      <svg class="mark" viewBox="0 0 220.64 180" aria-hidden="true" focusable="false">
        <path d={MARK} fill="currentColor" />
      </svg>

      <h1 class="wordmark">{site.showName}</h1>

      <p class="status">Coming Soon</p>

      <p class="tagline">Learn it. Test it. Build it.</p>

      <hr class="rule" />

      {
        NETWORKS.length > 0 && (
          <nav class="socials" aria-label="Social profiles">
            {NETWORKS.map((n) => (
              <a href={n.url} rel="noopener noreferrer me" target="_blank" aria-label={n.label}>
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d={n.path} fill="currentColor" />
                </svg>
              </a>
            ))}
          </nav>
        )
      }

      <p class="contact">
        <a href={`mailto:${site.holdingEmail}`}>{site.holdingEmail}</a>
      </p>
    </main>
  </body>
</html>
