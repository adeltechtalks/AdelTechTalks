---
/* Tech Passport — the account surface.
   Recreated from ui_kits/playground/Passport.jsx. Key rule from that kit:
   earned vs unearned is carried by FORM (filled circle vs dashed outline),
   not colour alone, so the state survives greyscale, colour-vision deficiency
   and single-colour print (IC v1.0).

   ONE Origin Corner on this page — the passport card. CS-05: no Spark element
   here; the passport records what has happened, nothing is advancing. */

import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import Icon from '../../components/Icon.astro';
import OriginFrame from '../../components/OriginFrame.astro';
import Button from '../../components/Button.astro';
import { playground, services } from '../../site.config';

const live = Boolean(services.supabaseUrl && services.supabaseAnonKey);

/* Each track is a stamp. Icon per pillar, matching the kit's mapping. */
const PILLAR_ICON = {
  ai: 'sparkles',
  gadgets: 'smartphone',
  automation: 'workflow',
  enterprise: 'building-2',
  creator: 'clapperboard',
} as const;

const stamps = playground.tracks.map((t) => ({
  slug: t.slug,
  label: t.badge,
  pillar: t.pillar,
  icon: PILLAR_ICON[t.pillar as keyof typeof PILLAR_ICON] ?? 'award',
}));
---

<Base title="Tech Passport" description="A record of what you have run — not what you have watched.">
  <section class="container">
    <div class="pp__head">
      <div class="pp__title">
        <h1 class="h-section">Tech Passport</h1>
        <p class="muted">A record of what you have run — not what you have watched.</p>
      </div>
      <div class="pp__account" data-account hidden>
        <span class="pp__avatar" data-avatar>A</span>
        <div class="pp__who">
          <span class="pp__name" data-name>—</span>
          <span class="pp__role">Tech Curator</span>
        </div>
        <button class="pp__signout" type="button" data-signout>Sign out</button>
      </div>
    </div>

    {!live && (
      <div class="pp__soon">
        <strong>Sign-in is not switched on yet.</strong>
        <span class="muted">Your passport appears here once the Playground is connected.</span>
      </div>
    )}

    <div class="pp__grid">
      <!-- ---------- stamps ---------- -->
      <Card elevation={1} padding="var(--atc-space-6)">
        <div class="pp__stampsHead">
          <strong class="pp__stampsTitle">Stamps</strong>
          <span class="pp__count" data-count>{live ? '—' : `0 of ${stamps.length} earned`}</span>
        </div>
        <div class="pp__stamps">
          {stamps.map((s) => (
            <div class="pp__stamp" data-stamp={s.slug}>
              <span class="pp__disc" data-disc style={`--pillar: var(--atc-category-${s.pillar}-graphic)`}>
                <Icon name={s.icon} size="lg" />
              </span>
              <span class="pp__label">{s.label}</span>
            </div>
          ))}
        </div>
      </Card>

      <!-- ---------- passport card + next stamp ---------- -->
      <div class="pp__side">
        <!-- SH-04: the single Origin Corner on this page -->
        <OriginFrame shorterSide={200} background="var(--atc-gradient-aurora)" class="pp__card">
          <div class="pp__cardInner">
            <span class="pp__cardLabel">Passport No.</span>
            <strong class="pp__cardNo" data-passport-no>ATT-————</strong>
            <span class="pp__cardIssued" data-issued>Not yet issued</span>
          </div>
        </OriginFrame>

        <Card elevation={1} padding="var(--atc-space-6)">
          <div class="pp__next">
            <div class="pp__progHead">
              <span class="pp__progLabel">Collection</span>
              <span class="pp__progVal" data-next-pct>0%</span>
            </div>
            <!-- brand tone, not Spark — nothing on this page is a call to action -->
            <div class="pp__track"><span class="pp__fill" data-next-fill style="width:0%"></span></div>
            <span class="muted pp__nextText" data-next-text>
              Sign in to start collecting stamps.
            </span>
            <Button variant="secondary" size="md" href="/playground" iconRight="arrow-right">
              Open the Playground
            </Button>
          </div>
        </Card>
      </div>
    </div>
  </section>
</Base>

<div
  id="pg-data"
  hidden
  data-supabase-url={services.supabaseUrl}
  data-supabase-key={services.supabaseAnonKey}
  data-tracks={JSON.stringify(playground.tracks)}
></div>

<script>
  const el = document.getElementById('pg-data');
  const url = el?.dataset.supabaseUrl;
  const key = el?.dataset.supabaseKey;

  if (el && url && key) {
    const tracks = JSON.parse(el.dataset.tracks ?? '[]');
    const pg = await import('../../lib/playground');

    (async () => {
      const sb = pg.getClient(url, key);
      const user = await pg.currentUser(sb);

      const $ = (sel: string) => document.querySelector<HTMLElement>(sel);
      const nextText = $('[data-next-text]');

      if (!user) {
        if (nextText) {
          nextText.textContent = '';
          const btn = document.createElement('button');
          btn.className = 'pg__google';
          btn.type = 'button';
          btn.textContent = 'Sign in with Google';
          btn.addEventListener('click', () => pg.signInWithGoogle(sb).catch((e) => alert(e.message)));
          nextText.appendChild(btn);
        }
        return;
      }

      /* ---- account row ---- */
      const name = user.user_metadata?.full_name || user.email || 'Signed in';
      const account = $('[data-account]');
      if (account) account.hidden = false;
      const nameEl = $('[data-name]');
      if (nameEl) nameEl.textContent = name;
      const avatar = $('[data-avatar]');
      if (avatar) avatar.textContent = (name[0] || 'A').toUpperCase();
      $('[data-signout]')?.addEventListener('click', () => pg.signOut(sb));

      /* ---- passport number: stable, derived from the account id ---- */
      const digits = (user.id.replace(/\D/g, '') + '0000').slice(0, 4);
      const noEl = $('[data-passport-no]');
      if (noEl) noEl.textContent = `ATT-${digits}`;
      const issued = user.created_at ? new Date(user.created_at) : null;
      const issuedEl = $('[data-issued]');
      if (issuedEl && issued) {
        issuedEl.textContent =
          'Issued ' + issued.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
      }

      /* ---- stamps ---- */
      const badges = await pg.loadBadges(sb, user.id);
      for (const t of tracks) {
        if (!badges.includes(t.slug)) continue;
        document.querySelector(`[data-stamp="${t.slug}"]`)?.classList.add('is-earned');
      }
      const countEl = $('[data-count]');
      if (countEl) countEl.textContent = `${badges.length} of ${tracks.length} earned`;

      /* ---- collection progress: badges are all-or-nothing per game ---- */
      const pct = Math.round((badges.length / tracks.length) * 100);
      const pctEl = $('[data-next-pct]');
      const fillEl = $('[data-next-fill]');
      if (pctEl) pctEl.textContent = `${pct}%`;
      if (fillEl) fillEl.style.width = `${pct}%`;

      const remaining = tracks.filter((t: any) => !badges.includes(t.slug));
      if (nextText) {
        nextText.textContent = remaining.length
          ? `Next up: “${remaining[0].name}” — ${remaining[0].rounds.length} rounds.`
          : 'Every badge collected. New games land with each product I publish.';
      }
    })();
  }
</script>

<style>
  .pp__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--atc-space-6);
    flex-wrap: wrap;
    margin-bottom: var(--atc-space-6);
  }
  /* Title and its one-line description belong together — 4px, per the kit. */
  .pp__title {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .pp__title p { font-size: var(--atc-body-small-size); }

  /* ---- account row, mirrors the kit's sidebar account block ---- */
  .pp__account {
    display: flex;
    align-items: center;
    gap: var(--atc-space-3);
  }
  /* display:flex above would otherwise beat the browser's [hidden] rule and
     show an empty account row to signed-out visitors. */
  .pp__account[hidden] {
    display: none;
  }

  /* Signed-out call to action inside the "next stamp" card.
     :global because the button is created by the script — Astro's scoped
     styles only reach elements present in the template at build time. */
  :global(.pg__google) {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    height: var(--atc-control-md);
    padding: 0 var(--atc-space-4);
    font-family: var(--atc-font-text);
    font-size: var(--atc-label-size);
    font-weight: var(--atc-label-weight);
    color: var(--atc-action-secondary-fg);
    background: var(--atc-action-secondary-bg);
    border: var(--atc-stroke-brand) solid var(--atc-stroke-brand-color);
    border-radius: var(--atc-radius-control);
    cursor: pointer;
  }
  :global(.pg__google:hover) { background: var(--atc-action-secondary-bg-hover); }
  .pp__avatar {
    width: 36px;
    height: 36px;
    border-radius: var(--atc-radius-circle);
    background: var(--atc-purple-600);
    color: var(--atc-white);
    display: grid;
    place-items: center;
    font-size: 14px;
    font-weight: 600;
    flex: 0 0 auto;
  }
  .pp__who {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }
  .pp__name { font-size: var(--atc-body-small-size); font-weight: 500; }
  .pp__role { font-size: 12px; color: var(--atc-ink-500); }
  .pp__signout {
    background: none;
    border: 0;
    padding: 4px 8px;
    font: inherit;
    font-size: var(--atc-body-small-size);
    color: var(--atc-purple-700);
    text-decoration: underline;
    cursor: pointer;
  }

  .pp__soon {
    display: flex;
    flex-direction: column;
    gap: var(--atc-space-2);
    padding: var(--atc-space-5);
    border: var(--atc-stroke-default) dashed var(--atc-ink-200);
    border-radius: var(--atc-radius-panel);
    background: var(--atc-surface-raised);
    font-size: var(--atc-body-small-size);
    margin-bottom: var(--atc-space-6);
  }

  .pp__grid {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: var(--atc-space-6);
    align-items: start;
  }

  .pp__stampsHead {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--atc-space-5);
  }
  .pp__stampsTitle { font-size: 22px; font-family: var(--atc-font-latin-disp); font-weight: 700; }
  .pp__count {
    font-size: var(--atc-body-small-size);
    color: var(--atc-ink-500);
    font-variant-numeric: tabular-nums;
    font-family: var(--atc-font-mono);
  }

  .pp__stamps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--atc-space-5);
  }
  .pp__stamp {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--atc-space-2);
    text-align: center;
  }

  /* UNEARNED — dashed outline, muted. The FORM carries the state. */
  .pp__disc {
    width: 64px;
    height: 64px;
    border-radius: var(--atc-radius-circle);
    display: grid;
    place-items: center;
    background: var(--atc-ink-50);
    border: 1.5px dashed var(--atc-ink-200);
    color: var(--atc-ink-300);
  }
  /* EARNED — solid pillar fill, no border. Distinguishable without colour. */
  .pp__stamp.is-earned .pp__disc {
    background: var(--pillar);
    border: none;
    color: var(--atc-white);
  }
  .pp__label {
    font-size: 12px;
    line-height: 18px;
    color: var(--atc-ink-300);
  }
  .pp__stamp.is-earned .pp__label {
    color: var(--atc-ink-900);
    font-weight: 500;
  }

  .pp__side {
    display: flex;
    flex-direction: column;
    gap: var(--atc-space-4);
  }
  .pp__card {
    height: 200px;
    display: grid;
    place-items: center;
    padding: var(--atc-space-6);
    box-sizing: border-box;
  }
  .pp__cardInner {
    text-align: center;
    color: var(--atc-white);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .pp__cardLabel {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.8;
  }
  .pp__cardNo {
    font-size: 28px;
    font-variant-numeric: tabular-nums;
    font-family: var(--atc-font-mono);
  }
  .pp__cardIssued { font-size: 13px; opacity: 0.85; }

  .pp__next {
    display: flex;
    flex-direction: column;
    gap: var(--atc-space-3);
  }
  .pp__progHead {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  .pp__progLabel { font-size: var(--atc-label-size); font-weight: var(--atc-label-weight); }
  .pp__progVal {
    font-family: var(--atc-font-mono);
    font-variant-numeric: tabular-nums;
    font-size: 12px;
    color: var(--atc-ink-500);
  }
  .pp__track {
    height: 8px;
    border-radius: var(--atc-radius-chip);
    background: var(--atc-ink-100);
    overflow: hidden;
  }
  .pp__fill {
    display: block;
    height: 100%;
    /* brand tone — Spark is reserved for things that are advancing */
    background: var(--atc-purple-600);
    transition: width var(--atc-duration-slow) var(--atc-ease-enter);
  }
  .pp__nextText { font-size: var(--atc-body-small-size); line-height: var(--atc-body-small-line); }

  @media (prefers-reduced-motion: reduce) {
    .pp__fill { transition: none; }
  }

  @media (max-width: 1023px) {
    .pp__grid { grid-template-columns: 1fr; }
    .pp__stamps { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 600px) {
    .pp__stamps { grid-template-columns: repeat(2, 1fr); }
  }
</style>
