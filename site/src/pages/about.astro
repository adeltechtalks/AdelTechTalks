---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import Button from '../components/Button.astro';
import { about, site } from '../site.config';
---

<Base title="About" description={site.description}>
  <section class="container">
    <div class="stack about__head">
      <span class="overline">About</span>
      <h1 class="h-display">{about.title}</h1>
      {about.body.map((p) => <p class="lede">{p}</p>)}
    </div>
  </section>

  <section class="container section">
    <div class="stack">
      <h2 class="h-section">How I work</h2>
      <div class="grid grid--4">
        {about.values.map((v) => (
          <Card>
            <strong class="h-card">{v.title}</strong>
            <span class="muted val__body">{v.body}</span>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <section class="container section">
    <Card elevation={2} padding="var(--atc-space-8)">
      <div class="stack">
        <h2 class="h-section">Working together</h2>
        <p class="lede">
          I partner with a small number of brands each quarter. Every partnership is disclosed,
          and I keep editorial control of the verdict.
        </p>
        <div class="row">
          <Button variant="secondary" size="md" href="/work-with-me" iconRight="arrow-right">
            See the packages
          </Button>
        </div>
      </div>
    </Card>
  </section>
</Base>

<style>
  .about__head { max-width: 720px; }
  .about__head .lede + .lede { margin-top: calc(var(--atc-space-2) * -1); }
  .val__body {
    font-size: var(--atc-body-small-size);
    line-height: var(--atc-body-small-line);
  }
</style>
