---
import Base from '../../layouts/Base.astro';
import Chip from '../../components/Chip.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import Card from '../../components/Card.astro';
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const guides = await getCollection('guides', ({ data }) => !data.draft);
  return guides.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
};

const { entry } = Astro.props;
const { Content } = await render(entry);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Base title={entry.data.title} description={entry.data.description}>
  <article class="container article">
    <header class="stack">
      <Chip pillar={entry.data.pillar}>{entry.data.pillar}</Chip>
      <h1 class="h-display">{entry.data.title}</h1>
      <p class="lede">{entry.data.description}</p>
      <span class="article__meta">
        {fmt(entry.data.date)}{entry.data.minutes ? ` · ${entry.data.minutes} min` : ''}
      </span>
    </header>

    <div class="prose">
      <Content />
    </div>

    <Card elevation={1} padding="var(--atc-space-8)" class="article__cta">
      <strong class="h-card">Get the next one</strong>
      <span class="muted">One email a week — what I tested and what was worth it.</span>
      <NewsletterForm compact />
    </Card>
  </article>
</Base>

<style>
  .article {
    /* Latin measure 60–75 characters */
    max-width: 760px;
  }
  .article__meta {
    font-family: var(--atc-font-mono);
    font-variant-numeric: tabular-nums;
    font-size: 12px;
    color: var(--atc-ink-500);
  }
  .article__cta {
    margin-top: 64px;
  }

  .prose {
    margin-top: 48px;
  }
  .prose :global(h2) {
    font-family: var(--atc-font-latin-disp);
    font-size: 28px;
    line-height: 36px;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 48px 0 var(--atc-space-4);
  }
  .prose :global(h3) {
    font-family: var(--atc-font-latin-disp);
    font-size: 20px;
    line-height: 28px;
    font-weight: 600;
    margin: 32px 0 var(--atc-space-3);
  }
  .prose :global(p) {
    margin: 0 0 var(--atc-space-5);
    font-size: var(--atc-body-base-size);
    line-height: var(--atc-body-base-line);
  }
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 var(--atc-space-5);
    padding-inline-start: var(--atc-space-6);
  }
  .prose :global(li) {
    margin-bottom: var(--atc-space-2);
  }
  .prose :global(blockquote) {
    margin: 0 0 var(--atc-space-5);
    padding: var(--atc-space-5) var(--atc-space-6);
    background: var(--atc-surface-sunken);
    border-radius: var(--atc-radius-panel);
    color: var(--atc-ink-700);
  }
  .prose :global(blockquote p:last-child) {
    margin-bottom: 0;
  }
  .prose :global(code) {
    background: var(--atc-purple-50);
    padding: 2px 6px;
    border-radius: var(--atc-radius-inline);
    font-size: 0.9em;
  }
  .prose :global(pre) {
    background: var(--atc-surface-sunken);
    padding: var(--atc-space-5);
    border-radius: var(--atc-radius-panel);
    overflow-x: auto;
    margin: 0 0 var(--atc-space-5);
  }
  .prose :global(pre code) {
    background: none;
    padding: 0;
  }
  .prose :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--atc-radius-card);
  }
</style>
