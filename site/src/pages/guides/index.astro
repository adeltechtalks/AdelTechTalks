---
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import Chip from '../../components/Chip.astro';
import { getCollection } from 'astro:content';

const guides = (await getCollection('guides', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<Base title="Guides" description="Hands-on guides — run the thing yourself and keep what you built.">
  <section class="container">
    <div class="stack">
      <span class="overline">Guides</span>
      <h1 class="h-display">Do it, don't just read it</h1>
      <p class="lede">
        Every guide here ends with something running on your machine. If it only teaches you a
        definition, it does not belong on this page.
      </p>
    </div>
  </section>

  <section class="container section--tight section">
    {guides.length === 0 ? (
      <Card>
        <strong class="h-card">No guides published yet</strong>
        <span class="muted">
          Add a Markdown file to <code>src/content/guides/</code> and it appears here automatically.
        </span>
      </Card>
    ) : (
      <div class="grid grid--3">
        {guides.map((g) => (
          <Card href={`/guides/${g.id}/`}>
            <Chip pillar={g.data.pillar}>{g.data.pillar}</Chip>
            <strong class="h-card">{g.data.title}</strong>
            <span class="muted g__desc">{g.data.description}</span>
            <span class="g__meta">
              {fmt(g.data.date)}{g.data.minutes ? ` · ${g.data.minutes} min` : ''}
            </span>
          </Card>
        ))}
      </div>
    )}
  </section>
</Base>

<style>
  .g__desc {
    font-size: var(--atc-body-small-size);
    line-height: var(--atc-body-small-line);
  }
  .g__meta {
    /* figures use the technical face with tabular numerals */
    font-family: var(--atc-font-mono);
    font-variant-numeric: tabular-nums;
    font-size: 12px;
    color: var(--atc-ink-500);
    margin-top: auto;
  }
  code {
    background: var(--atc-purple-50);
    padding: 1px 5px;
    border-radius: var(--atc-radius-inline);
    font-size: 12px;
  }
</style>
