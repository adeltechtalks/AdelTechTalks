---
/* Build Story — /builds/<slug>, English.

   The route exists for every build that is not a draft. The screenshot is NOT
   a gate: a build with no `heroShot` publishes and renders BrowserFrame's
   designed empty screen, and adding the real one later swaps it in without
   moving anything. Phase 1 publishes the write-up, which is the work. */

import BuildStory from '../../components/pages/BuildStory.astro';
import { getBuilds } from '../../lib/pillars';
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const stories = await getBuilds('en');
  if (stories.length === 0) return [];
  const entries = await getCollection('builds');
  return stories.map((story) => ({
    params: { slug: story.slug },
    props: { story, entry: entries.find((e) => e.id === story.slug)! },
  }));
};

const { story, entry } = Astro.props;
const { Content } = await render(entry);
---
<BuildStory lang="en" story={story}>
  <Content />
</BuildStory>
