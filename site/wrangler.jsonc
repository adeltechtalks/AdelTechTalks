{
  // Deployment config for Cloudflare Workers.
  //
  // This file used to be generated on the fly: Cloudflare's build ran
  // `astro add cloudflare` on every deploy, which rewrote astro.config.mjs and
  // invented a wrangler config from whatever adapter version was current that
  // day. The deployed setup was therefore decided at build time rather than by
  // anything in this repository. Declaring both explicitly makes every deploy
  // identical and reviewable.
  //
  // "name" must match the Worker in the Cloudflare dashboard.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "adeltechtalks-sites",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  // The server entry Astro emits. Only /badge/* actually reaches it —
  // every other route is a static file served straight from the CDN
  // (see dist/_routes.json after a build).
  "main": "dist/_worker.js/index.js",
  "assets": {
    "binding": "ASSETS",
    "directory": "dist"
  },
  // ---- runtime secrets -----------------------------------------------------
  // NAMES ONLY. No value is ever written here — this file is in source control.
  //
  // Why this exists: a secret set under Workers Builds -> Variables and secrets
  // is BUILD-TIME only. It is not attached to the Worker at runtime, and the
  // deploy succeeds anyway. Production ran for a period with the service-role
  // key present in the dashboard and absent from the running version, which the
  // runtime diagnostic caught as:
  //
  //   localsRuntimeEnvKeys:["ASSETS"] cloudflareWorkersEnvKeys:["ASSETS"]
  //
  // Declaring the name here makes the requirement explicit and machine-checked
  // rather than tribal knowledge. The VALUE is provisioned separately through
  // Cloudflare's runtime-secret mechanism (`wrangler secret put`, or Settings ->
  // Variables and Secrets on the Worker itself, NOT the Builds tab).
  "secrets": {
    "required": ["SUPABASE_SERVICE_ROLE_KEY"]
  },

  "observability": {
    "enabled": true
  }
}
