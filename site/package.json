{
  "name": "adeltechtalks-site",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/postbuild.mjs",
    "preview": "astro preview",
    "og": "node scripts/build-og-adel.mjs && node scripts/build-og.mjs",
    "qa": "node scripts/qa.mjs",
    "security": "npm run security:secrets && npm run security:policy && npm run security:rls",
    "security:secrets": "node scripts/security/secret-scan.mjs --self-test && node scripts/security/secret-scan.mjs",
    "security:dist": "node scripts/security/secret-scan.mjs --dist",
    "security:policy": "node scripts/security/policy-audit.mjs",
    "security:rls": "node scripts/security/rls-check.mjs",
    "new": "node scripts/new.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.10",
    "@astrojs/sitemap": "^3.7.3",
    "@supabase/supabase-js": "^2.112.0",
    "astro": "^5.18.2",
    "lucide-static": "^0.473.0"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "wrangler": "^4.118.0"
  }
}
